# Copy to .env.local (eve dev loads it). Never commit real keys.

# Leave EVE_EXAMPLE_MODEL unset to run with the deterministic mock model (no key, no cost).
# Set it to a gateway model id to use a real model, plus ONE credential:
# EVE_EXAMPLE_MODEL=anthropic/claude-haiku-4.5
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Where coding.sh's OTLP receiver listens (`coding.sh collector`). Default shown.
# CODING_SH_OTLP_URL=http://127.0.0.1:4318/v1/traces

# Turn off eve CLI usage telemetry (unrelated to agent traces).
EVE_TELEMETRY_DISABLED=1
