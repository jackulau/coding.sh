{
  "name": "coding.sh",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @coding.sh/site",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "dogfood": "node scripts/dogfood/score.mjs",
    "dogfood:validate": "node scripts/dogfood/cli-suite.mjs validate",
    "dogfood:test": "node --test \"scripts/dogfood/test/*.test.mjs\"",
    "lint": "node scripts/lint/slop.mjs",
    "gate": "node scripts/gate.mjs",
    "lint:test": "node --test \"scripts/lint/test/*.test.mjs\" \"scripts/hooks/test/*.test.mjs\"",
    "hooks:install": "node scripts/hooks/install.mjs"
  },
  "engines": {
    "node": ">=22.16"
  }
}
