{
  "name": "coding.sh",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @coding.sh/site",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "dogfood": "node scripts/dogfood/score.mjs",
    "dogfood:validate": "node scripts/dogfood/cli-suite.mjs validate",
    "dogfood:test": "node --test \"scripts/dogfood/test/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.15"
  }
}
