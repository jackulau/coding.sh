# Optional settings for deploy/compose/compose*.yml. Nothing here is required.
# Copy this file to deploy/compose/.env (next to the compose files) and uncomment what you need.

# The image. Pin a release (ghcr.io/jackulau/coding.sh:0.2.0) to upgrade on your own schedule.
# CODING_SH_IMAGE=ghcr.io/jackulau/coding.sh:latest

# Where to publish port 4318 on this machine. The default, 4318, listens on every interface.
# 127.0.0.1:4318 keeps it to this machine, for a TLS proxy in front.
# CODING_SH_PUBLISH=127.0.0.1:4318

# Your own keys instead of the ones serve makes on first start. Comma-separated; each entry is
# project:key or project:sha256:<hex> (coding.sh serve keygen prints both). Set an ingest key and
# a way to read (a read key or the viewer login below), or serve refuses to start.
# CODING_SH_INGEST_KEYS=team:sha256:<hex>
# CODING_SH_READ_KEYS=*:sha256:<hex>

# One shared viewer login (user:password) that sees every project, instead of or next to read keys.
# CODING_SH_BASIC_AUTH=team:a-long-password

# Delete sessions older than this many days, every hour.
# CODING_SH_RETENTION_DAYS=30

# Set to 1 behind a TLS proxy that sets X-Forwarded-Proto (Caddy, nginx, a load balancer).
# CODING_SH_TRUST_PROXY=1

# Database passwords, read on the database's first start only.
# POSTGRES_PASSWORD=
# CLICKHOUSE_PASSWORD=
