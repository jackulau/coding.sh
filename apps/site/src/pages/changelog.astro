---
// /changelog: every release as a short summary, newest first, with a sticky
// release list beside it. The full notes for a release are one click away at
// /changelog/<version>. Both are rendered from CHANGELOG.md at build time
// (see src/lib/changelog.ts), so the pages and the file can never disagree.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import ChangelogRail from "../components/ChangelogRail.astro";
import CubeField from "../components/CubeField.astro";
import { REPO_URL } from "../data/site";
import { releases } from "../lib/changelog";
import "../styles/changelog.css";

const count = releases.length;
const oldest = releases[releases.length - 1];
---

<Layout title="Changelog · coding.sh" description="Every coding.sh release, newest first: what changed in capture, cost, evals and the viewer. Each version has its own page, and /changelog.xml is the feed." breadcrumbs={[{ name: "Changelog", path: "/changelog" }]} image="/og/changelog.png">
  <Nav />
  <main id="main">
    <header class="cl-head">
      <CubeField variant="side" />
      <div class="wrap cl-head__inner" data-field-clear>
        <h1>Changelog</h1>
        <p class="cl-head__sub">Every release, newest first, with the full notes one click away.</p>
        <p class="cl-meta">
          {count} {count === 1 ? "release" : "releases"}{oldest?.date && /^\d/.test(oldest.date) && ` since ${oldest.dateLabel}`} · <a class="inline-link" href="/changelog.xml">RSS</a> · from <a class="inline-link" href={`${REPO_URL}/blob/main/CHANGELOG.md`}>CHANGELOG.md</a>
        </p>
      </div>
    </header>

    <div class="wrap cl-frame">
      <nav class="cl-rail" aria-label="Releases" data-cl-rail data-agent-skip>
        <p class="cl-rail__label">Releases</p>
        <ol role="list">
          {
            releases.map((r, i) => (
              <li>
                <a href={`#${r.slug}`} aria-current={i === 0 ? "true" : "false"}>
                  <span>v{r.version}</span>
                  {r.date && <small>{r.dateLabel}</small>}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="cl-feed">
        {
          releases.map((r) => (
            <article class="cl-card" id={r.slug} aria-labelledby={`${r.slug}-h`}>
              {r.date && <p class="cl-date">{r.dateLabel}</p>}
              <h2 id={`${r.slug}-h`} class="cl-card__ver">
                <a class="hit" href={`/changelog/${r.slug}`}>v{r.version}</a>
              </h2>
              {r.summary.map((p) => <p class="cl-card__sum" set:html={p} />)}
              <a class="cl-more hit" href={`/changelog/${r.slug}`} aria-label={`Read the notes for v${r.version}`}>
                Read the notes
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h9.5M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              {r.areas.length > 0 && (
                <div class="cl-card__areas">
                  <p class="cl-card__count">
                    {r.count} {r.count === 1 ? "change" : "changes"} in v{r.version}
                  </p>
                  <ul class="cl-chips" role="list">
                    {r.areas.map((a) => (
                      <li>
                        <a href={`/changelog/${r.slug}#${a.id}`}>
                          {a.name}
                          <small>{a.entries.length}</small>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </main>
</Layout>

<ChangelogRail />
