---
import DocsLayout from "../../components/docs/DocsLayout.astro";
import Code from "../../components/docs/Code.astro";

// Tool list and config shapes follow packages/coding.sh/src/mcp/tools.ts and
// src/adapters/_shared/mcp.ts (what `coding.sh init` writes for each agent).
const TOOLS: [string, string][] = [
  ["improve", "What goes wrong most in this repo's sessions, ranked, each with the AGENTS.md line that fixes it."],
  ["harness_changes", "Each committed AGENTS.md, rule or skill change: flagged sessions before and after, and a verdict."],
  ["harness_audit", "Each memory file, AGENTS.md, rule and skill with its load tokens and the sessions that used it, unused first. With check: true, whether uncommitted edits deleted, reworded or relaxed a protected line."],
  ["session_current", "The session of the agent calling the tool: its summary and latest timeline."],
  ["sessions_list", "Captured sessions, newest first, with turns, tool errors, tokens, cost and flags. Filter with flag or where."],
  ["session_get", "One session as a digest: per-turn index and a timeline of prompts, replies, tool calls and model calls."],
  ["session_replay", "A session as numbered steps, with the files as of any step, and a step's or a range's diff. With fork, a step's model call sent again with changed files."],
  ["search", "Full-text search over prompts, replies and tool input/output across all sessions. Takes where too."],
  ["failures", "The raw data behind improve: flagged sessions, frequent tool errors, prompts where the user pushed back."],
  ["latency", "Model-call p50/p95 and time to first token, plus the slowest tools and tool calls."],
  ["usage", "Tokens and cost by day, agent, model or repo, with the most expensive sessions. Takes where too."],
  ["subagents", "The subagents a session spawned, as a tree with durations and errors."],
  ["session_tree", "A whole multi-agent run as one tree, with per-node cost, tokens and flags and rolled-up totals."],
  ["eval_candidates", "Captured sessions ranked as eval candidates by failure flags, pushback, a guessable verifier and recency."],
  ["experiments_list", "Dataset experiments with pass rate and confidence interval."],
  ["experiment_compare", "Paired comparison of two experiments: difference, p-value, regressed and improved cases."],
  ["exp_session_summary", "The experiment session's timeline: notes, commands and each run with its delta against the previous run."],
  ["exp_session_note", "Add a note to the experiment session: a hypothesis before a run, the reading after it."],
  ["harness_compare", "Harness A/B results from coding.sh compare: the list, or one report with its gates."],
  ["benchmarks", "Benchmarks: the list, one run's leaderboard, or one metric over time."],
  ["eval_from_session", "Draft an eval task from a session."],
  ["eval_init", "Write an eval suite to evals/<name>/: tasks from failed sessions, a skill's trigger prompts, or cases the agent writes. What the agent writes is marked draft."],
  ["score_list", "Typed scores on sessions, events, dataset cases and eval runs, newest first, with filters."],
  ["score_add", "Score a session, event, case or run: a number, true or false, or a category. Scoring the same thing again replaces it."],
  ["status", "Health of coding.sh: version, available update, recent captures, pending spool, last error."],
];

// The skills follow packages/coding.sh/skills/<name>/SKILL.md.
const SKILLS: [string, string][] = [
  ["improve-agent-setup", "Find what goes wrong most and the AGENTS.md line that fixes it, then check whether a committed change helped."],
  ["trim-agent-setup", "Find the memory files, rules and skills that sessions never read and what the loaded ones cost, and trim them without losing a protected line."],
  ["review-agent-session", "Read one recorded session: what the agent did, where it failed or went in circles, and what it cost."],
  ["build-agent-evals", "Turn failed sessions, a skill's trigger prompts or your own cases into an eval suite, and read a paired comparison of two runs."],
];

const init = `coding.sh init          # hooks + MCP server for every detected agent
coding.sh init --no-mcp # hooks only
coding.sh mcp config    # print the server command for manual setup`;

const claude = `claude mcp add -s user coding-sh -- coding.sh mcp`;

const claudeJson = `// ~/.claude.json
{
  "mcpServers": {
    "coding-sh": { "type": "stdio", "command": "coding.sh", "args": ["mcp"], "env": {} }
  }
}`;

const codex = `# ~/.codex/config.toml
[mcp_servers.coding-sh]
command = "coding.sh"
args = ["mcp"]`;

const cursor = `// ~/.cursor/mcp.json
{
  "mcpServers": {
    "coding-sh": { "command": "coding.sh", "args": ["mcp"] }
  }
}`;

const opencode = `// ~/.config/opencode/opencode.json
{
  "mcp": {
    "coding-sh": { "type": "local", "command": ["coding.sh", "mcp"], "enabled": true }
  }
}`;

const gemini = `// ~/.gemini/settings.json
{
  "mcpServers": {
    "coding-sh": { "command": "coding.sh", "args": ["mcp"] }
  }
}`;
---

<DocsLayout>
  <p>
    Any AI agent with MCP can ask it "what failed last time?" or "what did this cost?" and get the answer from its own sessions.
  </p>

  <h2 id="automatic">You don't set it up</h2>
  <p>
    The install script runs <code>coding.sh init</code>, which adds capture hooks and the MCP server for every agent it finds. It registers
    the server at user scope with Claude Code, Codex, Cursor, OpenCode and older Gemini CLI installs, backing up each file first.
  </p>
  <Code code={init} />
  <p>
    The entry points at the installed CLI by absolute path, so agents started from a dock or an IDE find it. <code>coding.sh uninstall</code>
    removes it, and restores a config file nobody touched since init byte for byte.
  </p>
  <p>Every call reads fresh data: the server ingests new hook events before it answers. There is no <code>coding.sh ingest</code> step.</p>

  <h2 id="tools">Tools</h2>
  <div class="doc-table">
    <table>
      <thead><tr><th>Tool</th><th>What it returns</th></tr></thead>
      <tbody>
        {
          TOOLS.map(([name, desc]) => (
            <tr>
              <td>
                <code>{name}</code>
              </td>
              <td>{desc}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p>
    Only <code>eval_from_session</code>, <code>eval_init</code>, <code>score_add</code> and <code>exp_session_note</code> write. Agents ask
    you before <code>eval_from_session</code> and <code>eval_init</code>. Notes have secrets redacted. <code>eval_init</code> and
    <code>score_add</code> are marked destructive, because <code>eval_init</code> with <code>force</code> replaces a suite and a new
    score replaces the one stored for the same target, name, source and person.
  </p>
  <p>
    A tool answer stays under 25,000 characters. When the rows asked for would be longer, the answer has fewer rows and a
    <code>limitUsed</code> field. A tool with a <code>cursor</code> argument also returns <code>nextCursor</code>, which starts at the
    first row left out. Rows are dropped, not cut.
  </p>
  <p>
    <code>session_replay</code> pages the files of a step, of a range and of the step list with <code>limit</code> and
    <code>cursor</code>. A diff or file over 16 KB is cut when the replay is built, and flagged <code>diffTruncated</code> or <code>contentTruncated</code>.
  </p>
  <p>
    A page takes whole rows while they fit, so a short page has <code>limitUsed</code> and a <code>nextCursor</code>. It cuts only
    when one row, or the rest of the answer, is still too long. Then the room is shared out: short text stays whole, the longest is
    cut, and a long list keeps its first items. Ids and paths are never cut.
  </p>
  <p>
    The answer then has <code>truncated: true</code>, a <code>note</code>, and a flag such as <code>diffTruncated</code> or
    <code>filesTruncated</code> (with <code>filesTotal</code>, or <code>truncatedKeys</code> on an object) on what was cut. A cut inside a tool input is flagged as <code>inputTruncated</code> on the
    object that holds the input (<code>detail</code>, or <code>action</code> in a fork answer), never inside the input.
  </p>

  <h2 id="protocol">Protocol</h2>
  <p>
    The server speaks MCP over stdio. It accepts the stateless 2026-07-28 revision (<code>server/discover</code>, no handshake) and
    the <code>initialize</code> handshake for 2025-11-25, 2025-06-18 and 2025-03-26. An <code>initialize</code> that asks for another
    version gets 2025-11-25. In a 2025-03-26 session it accepts JSON-RPC batches; in later versions batches are an error.
  </p>
  <p>
    In 2026-07-28, list and read results carry <code>ttlMs</code> and <code>cacheScope</code>: the tool, prompt and template lists
    are <code>public</code> for an hour, <code>server/discover</code> for 5 minutes (<code>ttlMs</code> 300000, because its
    instructions carry an update notice), and session resources are <code>private</code> and stale at once. The skill
    list is <code>public</code> for an hour. A skill's entry, files and folder listings are <code>public</code> and stale at once.
  </p>
  <p>
    A request cancelled with <code>notifications/cancelled</code> gets no reply, except <code>initialize</code>, which can't be
    cancelled. Requests run one at a time, so a cancelled request that has not started never runs.
  </p>
  <p>
    A message with a null <code>id</code> whose method starts with <code>notifications/</code> is a notification and gets no
    reply. Any other request with a null <code>id</code> gets an invalid-request error.
  </p>

  <h2 id="prompts">Prompts and resources</h2>
  <div class="doc-table">
    <table>
      <thead><tr><th>Prompt</th><th>In Claude Code</th><th>What it does</th></tr></thead>
      <tbody>
        <tr><td><code>improve</code></td><td><code>/mcp__coding-sh__improve</code></td><td>Find the top issue and the line that fixes it.</td></tr>
        <tr><td><code>trim</code></td><td><code>/mcp__coding-sh__trim</code></td><td>Find memory files, skills and instructions sessions never read, then check the edits.</td></tr>
        <tr><td><code>did-it-help</code></td><td><code>/mcp__coding-sh__did-it-help</code></td><td>Whether a committed change helped, with an optional <code>commit</code>.</td></tr>
      </tbody>
    </table>
  </div>
  <p>
    See <a href="/docs/improve">What to fix first</a>. Resources:
    <code>codingsh://latest</code> and <code>codingsh://session/&lt;id&gt;</code>, each a Markdown digest of one session.
  </p>

  <h2 id="skills">Skills</h2>
  <p>
    The server also serves four <a href="https://agentskills.io">Agent Skills</a>. Each one tells the agent which of the tools above
    to call, and in what order, for one job. A host that supports MCP skills lists them next to its own skills and loads one when
    your request matches.
  </p>
  <div class="doc-table">
    <table>
      <thead><tr><th>Skill</th><th>Use it to</th></tr></thead>
      <tbody>
        {
          SKILLS.map(([name, desc]) => (
            <tr>
              <td>
                <code>{name}</code>
              </td>
              <td>{desc}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p>
    The skills are built into the CLI, so they name the tools of the version you run. Nothing is written to your skills folders.
    A host shows them only when it supports the extension. In any host with MCP prompts, the prompts above run the improve and
    trim loops.
  </p>
  <p>
    The server declares the <code>io.modelcontextprotocol/skills</code> extension. <code>skills/list</code> and
    <code>skills/get</code> return each skill's frontmatter with the SHA-256 digest and size of every file.
    <code>resources/read</code> returns a file at <code>skill://&lt;name&gt;/&lt;path&gt;</code>, and
    <code>resources/directory/read</code> lists a skill's folder. Each <code>SKILL.md</code> is also on the first page of
    <code>resources/list</code>, after the sessions.
  </p>

  <h2 id="manual">Manual config</h2>
  <p>
    For a machine where you'd rather not run <code>init</code>, or a project-scoped setup. These use the <code>coding.sh</code> binary on
    <code>PATH</code>; <code>coding.sh mcp config</code> prints the absolute-path form.
  </p>
  <h3 id="claude-code">Claude Code</h3>
  <Code code={claude} />
  <Code title="json" code={claudeJson} />
  <h3 id="codex">Codex</h3>
  <Code title="toml" code={codex} />
  <h3 id="cursor">Cursor</h3>
  <Code title="json" code={cursor} />
  <h3 id="opencode">OpenCode</h3>
  <Code title="json" code={opencode} />
  <h3 id="gemini">Gemini CLI (older installs)</h3>
  <Code title="json" code={gemini} />

  <h2 id="next">Next steps</h2>
  <ul>
    <li><a href="/docs/explore">Find and read runs</a>: the same sessions from the command line and the viewer.</li>
    <li><a href="/docs/query">Query language</a>: the <code>where</code> filter that <code>sessions_list</code>, <code>search</code> and <code>usage</code> take.</li>
    <li><a href="/docs/improve">What to fix first</a>: the loop behind the <code>improve</code> tool.</li>
  </ul>
</DocsLayout>
