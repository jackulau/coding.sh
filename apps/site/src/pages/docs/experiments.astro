---
import DocsLayout from "../../components/docs/DocsLayout.astro";
import Code from "../../components/docs/Code.astro";
import Terminal from "../../components/Terminal.astro";
import Tag from "../../components/docs/Tag.astro";

const replayCall = `coding.sh exp replay latest#-1 --vary model=claude-sonnet-4-5,claude-haiku-4-5 --n 5 --dry-run
coding.sh exp replay latest#-1 --vary model=claude-sonnet-4-5,claude-haiku-4-5 --n 5
coding.sh exp replay --session latest --limit 10 --vary system=@new-prompt.md`;

const sweepCall = `coding.sh exp sweep base=base.json t2=temp2.json t5=temp5.json -d smoke -g '{"kind":"exact"}' --budget 300`;

// The evals guide holds the method behind every line this page shows.
const GUIDE = "https://github.com/jackulau/coding.sh/blob/main/docs/guides/evals.md";

const matrix = `{
  "name": "shout-matrix",
  "dataset": "qa",
  "task": { "kind": "command", "command": "node agent.mjs", "env": { "MODEL": "stub-small", "PROMPT": "plain.md" } },
  "graders": [{ "kind": "regex", "pattern": "^[A-Z]+$" }],
  "matrix": {
    "model": { "path": "/task/env/MODEL", "values": [{ "small": "stub-small" }, { "big": "stub-big" }] },
    "prompt": { "path": "/task/env/PROMPT", "values": [{ "plain": "plain.md" }, { "shout": "shout.md" }] }
  },
  "baseline": { "model": "small", "prompt": "plain" }
}`;

const matrixOut = `cell                        pass     B − A    p  p (Holm)  verdict
model=small,prompt=plain    0.0%  baseline
model=small,prompt=shout  100.0%  +100.0pp  0.008     0.023  better
model=big,prompt=plain     50.0%   +50.0pp  0.125     0.125  inconclusive
model=big,prompt=shout    100.0%  +100.0pp  0.008     0.023  better`;

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const m = (s: string) => `<span class="t-muted">${esc(s)}</span>`;
const t = (s: string) => `<span class="t-text">${esc(s)}</span>`;
const ok = (s: string) => `<span class="t-pass">${esc(s)}</span>`;
const no = (s: string) => `<span class="t-fail">${esc(s)}</span>`;

// Real output of exp compare on the base run from /docs/evals and a second run (2026-11-06, throwaway CODING_SH_HOME).
const COMPARE = [
  `${m("$")} ${t("coding.sh exp compare exp_01M6SAJYC5RM7A5TCT65R3SFSM exp_01M6SAK893Z1DFH770KVNQC4BZ")}`,
  `A base exp_01M6SAJYC5RM7A5TCT65R3SFSM  pass 100.0%`,
  `B cand exp_01M6SAK893Z1DFH770KVNQC4BZ  pass 50.0%`,
  "",
  `B − A   ${no("-50.0pp")} [-100.0pp, 0.0pp] (2 paired cases, 95% paired bootstrap)`,
  `mcnemar p=1.000  1 regressed, 0 improved`,
  `verdict inconclusive (CI includes 0)`,
  "",
  `regressions 1`,
  `case                   A   B       Δ`,
  m(`------------------  ----  --  ------`),
  `c_756966685591eb9b  100%  ${no("0%")}  -100pp`,
].join("\n");

// Real output of scripts/e2e/exp-session-watch.mjs (2026-11-07): a command agent and an LLM judge against a stub model.
const SESSION = [
  `${m("$")} ${t("coding.sh exp run spec.json")}`,
  m("…"),
  `session shout: vs exp_01M6W03B3SPG7NSG4MEM9T032J  ${m("changed prompt.md")}`,
  `pass    0.0% → 100.0%  Δ ${ok("+100.0pp [+100.0pp, +100.0pp]")}  mcnemar p=0.125 ${m("(4 paired cases, 95% CI)")}`,
  `grader  caps  score Δ ${ok("+100.0pp [+100.0pp, +100.0pp]")}`,
  `fixed   4: alpha, beta, delta, gamma`,
  `broke   —`,
  "",
  `${m("$")} ${t("coding.sh exp run spec.json --watch")}`,
  `15:54:41  run     exp_01M6W03CN9P1ZE633C2RXPGVYQ  pass 100.0% (4/4)  4 case runs`,
  `15:54:41  regrade exp_01M6W03D5H1YEKWWXWGNCGN7MF  pass 75.0% (3/4)  regrade of exp_01M6W03CN9P1ZE633C2RXPGVYQ, 0 task calls`,
].join("\n");
---

<DocsLayout>
  <p>
    An experiment is one graded run of a task over a dataset (see <a href="/docs/evals">Evals</a>). This page covers what comes next:
    compare two runs, pick the best of several configs, know when a loop should stop, and keep long runs going.
    Every flag is in the <a href="/docs/cli/exp">exp reference</a>.
  </p>

  <h2 id="compare">Compare two runs <Tag status="built" /></h2>
  <p>
    <code>exp compare A B</code> pairs the two runs by case. It prints B − A with a paired bootstrap interval, McNemar's exact test on the
    cases that flipped, and the cases that regressed. When the interval includes zero, the verdict is inconclusive.
  </p>
  <Terminal title="~/smoke" label="Output of coding.sh exp compare">
    <pre set:html={COMPARE} />
  </Terminal>
  <div class="doc-table">
    <table>
      <thead><tr><th>Flag</th><th>What it adds</th></tr></thead>
      <tbody>
        <tr><td><code>--gate</code></td><td>A ship-or-hold line; exits 0 only for "Ship it" (<a href="/docs/harness-evals#gate">how it decides</a>).</td></tr>
        <tr id="non-inferiority"><td><code>--margin 0.03</code></td><td>Non-inferiority: exits 1 unless the interval's lower end is above −3pp.</td></tr>
        <tr><td><code>--cluster repo</code></td><td>Resamples groups of related cases instead of single cases; warns below 10 groups.</td></tr>
        <tr id="coverage"><td><code>--matrix</code></td><td>The cases by passes out of k in A and in B.</td></tr>
        <tr id="judges"><td><code>--pairwise judge.json</code></td><td>A judge that sees both outputs in both orders. Repeat it to ask several.</td></tr>
        <tr id="ppi"><td><code>--labels-a</code>, <code>--labels-b</code></td><td>Human labels that correct each LLM judge's B − A (PPI++).</td></tr>
        <tr id="seq"><td><code>--verdict seq</code></td><td>The verdict from Seq@K, when both runs used the same <code>--seq</code> and <code>--feedback</code>.</td></tr>
      </tbody>
    </table>
  </div>
  <details class="more">
    <summary>What else compare reports</summary>
    <ul>
      <li>With <a href="/docs/evals#case-kinds">case kinds</a>: each kind's pass rate, bad cases that do not show the fix, and broken guards and controls.</li>
      <li>Below 100 paired cases: P(B&gt;A) from a Bayesian posterior. The bootstrap interval stays.</li>
      <li>Trials lost to errors, split into infra and agent errors, with a warning when the split is uneven.</li>
      <li>After <code>exp aa</code> (one config run twice): the A/A flip rate. The minimum detectable effect never goes below it.</li>
      <li>The exact McNemar power: <code>no 80% power at this n (exact McNemar ceiling 62%)</code>, or <code>exact MDE 10.6pp</code>.</li>
      <li>A warning when the two runs ran one after the other.</li>
      <li>With 2+ trials per case: the cases B gained and lost (<code>lost coverage</code>). A net gain can hide lost cases.</li>
      <li id="grader-versions">A warning when a grader changed version between A and B, or graded one side only. Ungraded cases are left out.</li>
      <li id="failing">When B ran with <code>exp run --failing A</code>: a regression-to-the-mean warning. The verdict is inconclusive and <code>--gate</code> holds.</li>
    </ul>
    <p>The <a href={`${GUIDE}#datasets-and-experiments`}>evals guide</a> has the method behind each line.</p>
  </details>

  <h2 id="regrade">Grade again with new graders <Tag status="built" /></h2>
  <p>
    <code>exp regrade &lt;experiment&gt; spec.json</code> grades a stored experiment's outputs again with the spec's graders, without calling
    the task. It prints the pass rate before and after, and every run whose outcome flipped. Regrade A with B's graders, then compare like
    with like.
  </p>

  <h2 id="arms">Run two configs as one A/B <Tag status="built" /></h2>
  <p>
    <code>exp run --arm base=a.json --arm cand=b.json</code> runs each case in both arms back to back, in random order, so drift during the
    run hits both arms the same. <code>--stop-early</code> stops once the answer is clear (an O'Brien-Fleming group sequential test, never
    before 20 cases). <code>--max-cases</code> caps the run.
  </p>

  <h2 id="sweep">Pick the best of several configs <Tag status="built" /></h2>
  <Code code={sweepCall} />
  <p>
    The race uses sequential halving: each round runs the surviving configs on the same fresh train cases and keeps the better half. The
    winner and the first config then run on the test split, which the race never saw. The output prints <code>adopt &lt;winner&gt;</code>
    or <code>keep &lt;start&gt;</code>, and the winner's optimism gap (train minus held-out score).
  </p>
  <div class="doc-table">
    <table>
      <thead><tr><th>Flag</th><th>What it adds</th></tr></thead>
      <tbody>
        <tr><td><code>--budget N</code></td><td>Caps the race's case runs.</td></tr>
        <tr id="guard"><td><code>--guard old-suite</code></td><td>An earlier suite the winner must not forget. If it does, the sweep keeps the start and exits 1.</td></tr>
        <tr><td><code>--guard-tau 0.10</code></td><td>The share of the start's solved guard cases the winner may break.</td></tr>
        <tr><td><code>--guard prior</code></td><td>Guards every suite a sweep adopted a config on before.</td></tr>
      </tbody>
    </table>
  </div>
  <p id="best-set">
    With three or more configs, a line names the <strong>plausibly best</strong> set: the configs not significantly worse than the best. It
    holds the truly best config 95% of the time, so a dropped config still in it may have lost on noise.
  </p>

  <h2 id="matrix">Run every combination <Tag status="built" /></h2>
  <p>
    A spec with <code>"matrix"</code> runs every combination of its axes against one baseline cell. Each axis is a JSON Pointer into the spec
    and a list of values (<code>"variants"</code> names cells by hand instead). A cell may change only <code>/task/…</code> and
    <code>/trials</code>; anything else is refused before it runs.
  </p>
  <Code title="matrix.json" code={matrix} />
  <p>
    <code>exp run matrix.json</code> runs the cells interleaved and compares each with the baseline. The p-values are Holm-adjusted over the
    cells, so a big matrix doesn't produce a winner by chance.
  </p>
  <Code code={matrixOut} />
  <div class="doc-table">
    <table>
      <thead><tr><th>Flag</th><th>What it adds</th></tr></thead>
      <tbody>
        <tr><td><code>--plan</code></td><td>Prints the cells and what each changes; runs nothing.</td></tr>
        <tr><td><code>--cell NAME</code></td><td>Runs only these cells. The baseline always runs.</td></tr>
        <tr><td><code>--reuse baseline</code></td><td>Copies the baseline's finished case-trials from earlier experiments (<code>all</code>: any cell's).</td></tr>
        <tr><td><code>--reuse-max-age 7d</code></td><td>Copies only case-trials that started this recently.</td></tr>
        <tr><td><code>--resume</code></td><td>Picks up an interrupted matrix.</td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="plateau">Know when to stop a loop <Tag status="built" /></h2>
  <p>
    Tag each round with <code>exp run … --series NAME</code>. It prints <code>series NAME: continue, incumbent v4 …</code> or
    <code>series NAME: stop, ship v2 … (the plateau began at round 3)</code>. <code>exp plateau --series NAME</code> prints one row per round
    and exits 0 (continue), 3 (stop) or 2 (too few experiments).
  </p>
  <details class="more">
    <summary>How it decides</summary>
    <p>
      Each round compares the candidate with the incumbent on the cases both ran. A restart e-detector (Yin, Liu and Qi, arXiv 2610.04756)
      stops once the gains stay below ε (<code>--eps</code>, default 0.05) and names the incumbent before the plateau as the version to ship.
    </p>
    <p>
      <code>--gate greedy</code> keeps a candidate only when it beats the incumbent; <code>--gate chain</code> keeps every one. False alarms
      come on average no sooner than every 1/δ rounds (20 at <code>--delta 0.05</code>): an average run length, not an error rate.
    </p>
  </details>

  <h2 id="resume">Resume a long run <Tag status="built" /></h2>
  <p>
    <code>exp run</code>, <code>exp aa</code>, <code>exp sweep</code>, <code>compare</code>, <code>bench run</code> and
    <code>workflows run</code> save each trial as it finishes. After Ctrl-C, a crash or a reboot, run the same command with
    <code>--resume</code>. Only the unfinished trials run, and the verdict matches a run that was never interrupted. If the dataset, graders,
    task or agent script changed, it refuses and names what changed.
  </p>
  <div class="doc-table">
    <table>
      <thead><tr><th>Flag</th><th>What it does</th></tr></thead>
      <tbody>
        <tr><td><code>--resume &lt;experiment&gt;</code></td><td>Runs what is left of a stored run that <code>exp list</code> marks <code>(partial)</code>.</td></tr>
        <tr><td><code>--retry-errors</code></td><td>With <code>--resume</code>: also runs its task errors again.</td></tr>
        <tr><td><code>--retries N</code></td><td>Retries rate limits, 5xx and network errors (default 3). Task failures are never retried.</td></tr>
        <tr><td><code>--trial-timeout SEC</code></td><td>Caps each trial, retries included.</td></tr>
      </tbody>
    </table>
  </div>
  <p><code>exp status</code> shows each run's progress, ETA and cost so far.</p>

  <h2 id="subset">Run part of a dataset, or retry with feedback <Tag status="built" /></h2>
  <div class="doc-table">
    <table>
      <thead><tr><th>Flag</th><th>What it does</th></tr></thead>
      <tbody>
        <tr><td><code>--failing</code>, <code>--case</code>, <code>--sample</code>, <code>--first-n</code></td><td>Run part of a dataset.</td></tr>
        <tr id="seq-attempts"><td><code>--seq 3 --feedback reasons</code></td><td>Tries a failing case-trial again with feedback, up to 3 attempts. The pass rate stays the first attempt's (<a href="/docs/cli/exp#cmd-exp-run">modes</a>).</td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="sessions">See each run's delta as you iterate <Tag status="built" /></h2>
  <p>
    <code>exp session new --name &lt;topic&gt;</code> starts a session in the current folder. Each <code>exp run</code> there then prints its
    delta against the previous run on the same dataset, and names the files that changed. <code>exp session note</code> records a hypothesis
    or a reading, and <code>exp session summary</code> prints the timeline.
  </p>
  <Terminal title="~/shout" label="Output of coding.sh exp run in a session and with --watch">
    <Fragment set:html={SESSION} />
  </Terminal>
  <p>
    <code>--watch</code> reruns whenever the spec, the agent script or a grader file changes. A change to the graders alone regrades the last
    outputs with no agent calls. Enter reruns, <code>q</code> quits.
  </p>

  <h2 id="metrics">Compare two numeric commands <Tag status="built" /></h2>
  <p>
    <code>exp metrics --arm base='node bench.mjs a' --arm cand='node bench.mjs b'</code> compares two commands that print numbers, such as
    <code>&#123;"lcp_ms": 2310&#125;</code>. The arms run in interleaved pairs (11 by default). For each metric it prints both medians, the
    paired difference with a 95% interval, and a verdict.
  </p>
  <p>
    Lower is better unless you name the metric in <code>--higher</code>. A change counts only when the interval excludes zero and a corrected
    sign test agrees, so an A/A run stays quiet. <code>--fail-on-worse</code> exits 1 for CI.
  </p>

  <h2 id="exp-replay">Replay one model call <Tag status="built" /></h2>
  <p>
    <code>exp replay</code> sends a call that <a href="/docs/how-to/capture-with-proxy">the proxy</a> logged again, with the model, the system
    prompt or any request field changed. One <code>--vary</code> value changes arm B and keeps arm A as recorded; two values set both.
    (<code>exp ab</code> replays a whole turn instead.)
  </p>
  <Code code={replayCall} />
  <p>
    A reply passes when its first action (a tool call by name, or text) matches the agent's; <code>--criterion</code> adds an LLM judge. The
    report is the paired comparison of <code>exp compare</code>. It uses your own <code>ANTHROPIC_API_KEY</code> or
    <code>OPENAI_API_KEY</code>, never the agent's login. <code>--dry-run</code> prints the call count and a cost estimate without a key.
  </p>
</DocsLayout>
