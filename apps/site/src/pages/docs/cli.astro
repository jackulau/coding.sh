---
import DocsLayout from "../../components/docs/DocsLayout.astro";
import Terminal from "../../components/Terminal.astro";
import { cliAnchor, cliPath, cliReference } from "../../components/docs/cli-help";

const ref = cliReference();
// Links to /docs/cli#cmd-<name> predate the per-command pages: send them on.
const commands = ref ? ref.groups.flatMap((g) => g.commands.map((c) => c.name)) : [];
---

<DocsLayout>
  {
    ref ? (
      <>
        <p>
          Generated at build time from <code>coding.sh --help</code> (version {ref.version}). Run <code>coding.sh &lt;command&gt; --help</code>{" "}
          for the same text in your terminal, or add <code>--json</code> for machine-readable metadata. Each command has its own page with its full
          help and its subcommands.
        </p>

        <h2 id="global">Global options</h2>
        <p>Every command accepts these.</p>
        <Terminal title="global options" label="Global options of coding.sh">
          <pre>{ref.globalOptions}</pre>
        </Terminal>
        <p>
          With <code>--json</code>, a command prints one JSON document on stdout and errors as one JSON line on stderr. Usage errors exit with
          code 2.
        </p>

        <h2 id="commands">Commands</h2>
        {ref.groups.map((g) => (
          <>
            <h3 id={`group-${g.label.toLowerCase()}`}>{g.label}</h3>
            <div class="doc-table">
              <table>
                <thead>
                  <tr>
                    <th>Command</th>
                    <th>What it does</th>
                  </tr>
                </thead>
                <tbody>
                  {g.commands.map((c) => (
                    <tr>
                      <td class="nowrap cell-link">
                        <a href={cliPath(c.name)}>
                          <code>{c.name}</code>
                        </a>
                      </td>
                      <td>
                        {c.summary}
                        {/* On one line: a line break here would put spaces inside "(a, b)". */}
                        {c.actions.length > 0 && <>({c.actions.map((a, i) => <>{i > 0 && ", "}<a class="inline-link" href={`${cliPath(a.name)}#${cliAnchor(a.name)}`}>{a.name.slice(c.name.length + 1)}</a></>)})</>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ))}
        <script is:inline define:vars={{ commands }}>
          {
            const id = decodeURIComponent(location.hash.slice(1));
            const name = commands.find((c) => id === `cmd-${c}` || id.startsWith(`cmd-${c}-`));
            if (name && !document.getElementById(id)) location.replace(`/docs/cli/${name}${location.hash}`);
          }
        </script>
      </>
    ) : (
      <div class="note">
        <p>
          <strong>Not generated.</strong> This page is built from the CLI's own <code>--help</code> output, and
          <code>packages/coding.sh/dist/cli.mjs</code> was not built when the site was. Run <code>npm run build -w coding.sh</code> and rebuild
          the site.
        </p>
      </div>
    )
  }
</DocsLayout>

<style>
  .doc :global(.term) {
    margin-top: 1rem;
  }
</style>
