  <Cards
    cards={[
      { href: "/docs/how-to/test-agents-md-change", title: "Test an AGENTS.md change", body: "One edit, replayed on the turns your agent got wrong." },
      { href: "/docs/how-to/evaluate-a-skill", title: "Evaluate a skill", body: "Whole tasks with and without a skill, graded by checks and a judge." },
      { href: "/docs/improve", title: "What to fix first", body: "The problems in your sessions, ranked, each with a line to add." },
      { href: "/docs/how-to/ci-regressions", title: "Catch a regression in CI", body: "The GitHub Action and `compare --gate` on pull requests." },
    ]}
  />
</DocsLayout>
