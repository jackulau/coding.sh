---
import DocsLayout from "../../components/docs/DocsLayout.astro";
import Code from "../../components/docs/Code.astro";
import Terminal from "../../components/Terminal.astro";
import Tag from "../../components/docs/Tag.astro";

const replay = `coding.sh eval new latest --verifier 'npm test' --hidden-test 'test/retry.spec.ts'
coding.sh eval validate <task> --k 5
coding.sh eval export <task> --out ./tasks/retry --format harbor
coding.sh harness snapshot --agent claude-code --name base
coding.sh compare base candidate --k 3`;

// The evals guide holds the method behind every line this page shows.
const GUIDE = "https://github.com/jackulau/coding.sh/blob/main/docs/guides/evals.md";

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const m = (s: string) => `<span class="t-muted">${esc(s)}</span>`;
const t = (s: string) => `<span class="t-text">${esc(s)}</span>`;
const ok = (s: string) => `<span class="t-pass">${esc(s)}</span>`;
const no = (s: string) => `<span class="t-fail">${esc(s)}</span>`;

// Real output of scripts/e2e/exp-ab-capture.mjs (2026-11-07): three Claude Code sessions against a stub
// model.
const AB = [
  `${m("$")} ${t("coding.sh exp ab")}`,
  `A: git:HEAD   B: your edits   model: claude-sonnet-5-5`,
  `3 decision points from 3 sessions | A 0/3 -> B ${ok("3/3")} | fixed 3, broke 0 | paired p=0.25 | <$0.01, 0/6 cached`,
  `Hold: not enough evidence (B wins 3, loses 0; needs 8+ wins with no losses)`,
  `Replay noise floor 0% (A's turn differs from the recorded one in 0/3); B moved +100 points, above it`,
  "",
  `Fixed (A failed, B passed):`,
  `  unverified-claim "Make pad.js pad on the left."  ${m("coding.sh show 8f0e1e52-bdc1-4da0-a03b-14edf6dfcf77")}`,
  `  unverified-claim "Make clamp.js clamp to the upper bound too."  ${m("coding.sh show 9c1792df-6267-4b30-9f24-7a7307740543")}`,
  `  unverified-claim "Make range.js include its end value."  ${m("coding.sh show fe48a450-8867-48ec-b946-3b4d0cb6c780")}`,
  "",
  `Full comparison: coding.sh exp compare exp_01M6VXZSFPM2QK12ANN6Z269WP exp_01M6VXZSFSZ25HD2HXXVY40BXV`,
].join("\n");

// Real output of scripts/e2e/refine-loop.mjs with its instructions file named AGENTS.md and the draft at ./drafts/AGENTS.md
// (run 2026-11-09 against a stub model and a throwaway HOME).
// With the script's default file name the same run prints r_3123c2cbef and r_b25de6ab68; nothing else differs.
const REFINE = [
  `${m("$")} ${t("coding.sh refine test ./drafts/AGENTS.md --behavior unchanged-retry")}`,
  `r_3b577b3897  ./drafts/AGENTS.md (AGENTS.md; +1 line)`,
  `  protected  ${ok("ok")} (1 protected line in place)`,
  `  critics    ${ok("ok")}`,
  `  dev        8 decision points | effect +100pp [+100pp, +100pp] | B wins 8, loses 0; A solved 0`,
  `  guard      8 tasks earlier kept edits won (0 from this run, 8 rerun) | ${no("forgets kept edit r_e67f549cae")}`,
  `  preserved  gained 8, lost 0, 0 tasks regressed`,
  `  verdict    ${no("reject")}: dev: Ship it: B wins 8 decision points, loses 0; guard: forgets kept edit r_e67f549cae`,
  "",
  `${m("$")} ${t("coding.sh refine log")}`,
  m(`ROUND  CANDIDATE     VERDICT        EFFECT (95% CI)          GUARD                 COST   REASON`),
  `1      r_e67f549cae  ${ok("keep, applied")}  +100pp [+100pp, +100pp]  no tasks              $0.02  dev: Ship it: B wins 8 decision points, loses 0`,
  `2      r_3b577b3897  ${no("reject")}         +100pp [+100pp, +100pp]  forgets r_e67f549cae  $0.02  guard: forgets kept edit r_e67f549cae`,
].join("\n");
const TRIGGER = [
  `${m("$")} ${t('coding.sh eval trigger skills/pdf --description "Use when the user mentions pdf, invoice, scanned." --yes')}`,
  `A (current): pdf on claude-code, k=1`,
  `  precision 67%  recall 50%  F1 0.57  accuracy 63%`,
  `  missed:`,
  `    should     loaded 0/1  "Make the invoice searchable"`,
  `    should_not false trigger 1/1  "Explain in one line what a pdf is"`,
  `  expected routes: docx 1/1`,
  `B (--description): pdf on claude-code, k=1`,
  `  precision 80%  recall 100%  F1 0.89  accuracy 88%`,
  "",
  `B vs A over 8 prompts: recall 2/4→4/4 · false triggers 1/4→1/4 · Δacc +25 pp (95% CI +0 to +63)`,
  `  flip ${ok("better")} should     skipped → loaded  "Make the invoice searchable"`,
  `  flip ${ok("better")} should     skipped → loaded  "OCR this scanned invoice"`,
  `  ${m("note: 4 should and 4 should_not prompts: only a large change can show; aim for 10+ per side")}`,
  `No clear difference`,
].join("\n");
---

<DocsLayout>
  <p>
    The harness is everything around the model: AGENTS.md, rules, skills, the agent and its flags. These commands test a change to it before
    you keep it, on the sessions you already have or on tasks replayed from your repo.
  </p>

  <h2 id="exp-ab">A/B a harness edit on your sessions <Tag status="built" /></h2>
  <p>
    You changed a line in AGENTS.md and want to know if it helps. <code>coding.sh exp ab</code> finds the moments in your recent sessions
    where the agent went wrong, such as saying it was done without running anything. It replays the next turn twice, once with your committed
    files and once with your edit, and a judge scores both.
  </p>
  <Terminal title="~/repo" label="Output of coding.sh exp ab">
    <Fragment set:html={AB} />
  </Terminal>
  <p>
    The noise floor is how often your committed files alone produce a different turn from the recorded one. A smaller difference may be
    replay noise. Responses are cached, so a rerun with unchanged files is free.
  </p>
  <div class="doc-table">
    <table>
      <thead><tr><th>Flag</th><th>What it does</th></tr></thead>
      <tbody>
        <tr><td><code>--dry-run</code></td><td>Shows the cases and a cost estimate; calls nothing.</td></tr>
        <tr><td><code>--max-cost</code></td><td>Caps the spend.</td></tr>
        <tr><td><code>--gate</code></td><td>Makes the verdict line the exit code.</td></tr>
        <tr><td><code>--watch</code></td><td>Reruns each time you save, one line per run.</td></tr>
      </tbody>
    </table>
  </div>
  <p>The walkthrough is <a href="/docs/how-to/test-agents-md-change">Test an AGENTS.md change in five minutes</a>.</p>

  <h2 id="protected">Keep safety lines from being dropped <Tag status="built" /></h2>
  <p>
    A pass-rate A/B can't see the harm of deleting "Never run <code>git push --force</code>" if no case needed it.
    <code>coding.sh refine check</code> compares a harness edit by text (default: git <code>HEAD</code> against your working tree) and exits 1
    when it deletes, rewords or relaxes a protected line. <code>exp ab</code> runs the same check and warns before any model call.
  </p>
  <p>
    A line is protected inside a <code>&lt;!-- coding.sh:protect --&gt;</code> block, when it matches a <code>[refine] protect</code> regex, or
    when one sentence pairs a word like never or must not with a safety topic such as credentials, deploy or <code>rm -rf</code>.
    <code>refine protected</code> lists them, and <code>--allow-protected-edit AGENTS.md:3</code> allows one edit on purpose
    (<a href={`${GUIDE}#protected-safety-lines`}>details</a>).
  </p>

  <h2 id="refine">Improve AGENTS.md in tested rounds <Tag status="built" /></h2>
  <p>
    <code>refine test</code> decides each candidate edit in stages: the protected-line check and two critics on the added lines, then an A/B
    on the decision points <code>exp ab</code> mines, through the same ship gate. Last comes the guard: what earlier kept edits won must stay
    solved.
  </p>
  <Terminal title="~/repo" label="Output of coding.sh refine test and refine log">
    <Fragment set:html={REFINE} />
  </Terminal>
  <p>Here the second edit wins its own decision points but drops the line the first edit added, so the guard rejects it.</p>
  <div class="doc-table">
    <table>
      <thead><tr><th>Command</th><th>What it does</th></tr></thead>
      <tbody>
        <tr><td><code>refine propose</code></td><td>Asks a model for lines that address your sessions' most severe flags.</td></tr>
        <tr><td><code>refine apply</code></td><td>Writes a kept candidate with a backup. Never commits.</td></tr>
        <tr><td><code>refine rollback</code></td><td>Restores the backup byte for byte.</td></tr>
        <tr><td><code>refine log</code></td><td>Every round with its verdict, effect, guard result, cost and reason.</td></tr>
        <tr><td><code>refine run</code></td><td>Loops propose, test and apply until <code>--rounds</code>, <code>--max-cost</code> or a plateau.</td></tr>
      </tbody>
    </table>
  </div>
  <p>See <a href={`${GUIDE}#refine-loop`}>Refine loop</a> in the evals guide.</p>

  <h2 id="triggers">Check that a skill loads <Tag status="built" /></h2>
  <p>
    A skill only helps when the agent loads it. <code>eval trigger &lt;skill-dir&gt;</code> reads a <code>triggers.toml</code> of
    <code>[[should]]</code> prompts and <code>[[should_not]]</code> near misses. It runs each prompt k times with the agent (Claude Code by default)
    and reads from the captured session whether the skill loaded. <code>--description</code> or <code>--candidate DIR</code> adds a second arm to compare.
  </p>
  <Terminal title="~/repo" label="Output of coding.sh eval trigger with a description A/B">
    <Fragment set:html={TRIGGER} />
  </Terminal>
  <p>
    The output above is the CI check with real Claude Code against a stub model. Eight prompts can't show a change of this size, so the verdict holds. <code>--min-f1</code> and <code>--fail-on regression</code> set the
    exit code for CI. See <a href="https://github.com/jackulau/coding.sh/blob/main/docs/how-to/evaluate-a-skill.md#does-the-skill-load">Does
    the skill load?</a>.
  </p>

  <h2 id="repo-replay">Replay tasks from your repo <Tag status="partial" /></h2>
  <p>
    A repo-replay task is the repository from before the agent ran, the first prompt as the instruction, and a verifier command.
    <code>compare</code> runs two harness bundles on those tasks in isolated worktrees.
  </p>
  <Code code={replay} />
  <p>Before a task counts, <code>eval validate</code> checks the verifier:</p>
  <ol>
    <li>Doing nothing fails.</li>
    <li>The reference solution passes <code>k</code> runs out of <code>k</code> (default 5), so flaky tests fail validation.</li>
    <li>Near-miss variants of the reference, made by mutating its patch, fail.</li>
    <li>Nothing leaks: hidden tests are copied in only when the verifier runs.</li>
  </ol>
  <p>
    A bundle is the agent, model, flags, env and files such as AGENTS.md, identified by a content hash. The report gives each arm's pass
    rate, the paired difference, McNemar's test, the cost, token and latency deltas, and the first step where the traces diverge.
  </p>
  <div class="doc-table">
    <table>
      <thead><tr><th>Command</th><th>What it adds</th></tr></thead>
      <tbody>
        <tr><td><code>eval crosscheck &lt;task&gt;</code></td><td>A reviewer model judges each run's diff and reports where it disagrees with the verifier.</td></tr>
        <tr id="witness"><td><code>eval audit &lt;task&gt; --experiment &lt;id&gt; --witness &lt;file&gt; --witness-cmd &lt;cmd&gt;</code></td><td>A test for a requirement the verifier skips; it can refute passing runs.</td></tr>
        <tr id="hand-written"><td><code>eval import tasks/*/</code></td><td>Loads hand-written tasks (<code>task.json</code>, <code>instruction.md</code>, <code>repo/</code>, <code>tests/</code>) as drafts. Run them with <code>compare A B --tag &lt;tag&gt;</code> (<a href="/docs/how-to/evaluate-a-skill">walkthrough</a>).</td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="gate">Gate a change in CI</h2>
  <p>
    <code>compare A B --gate</code> answers "should I ship B?" in one line: <code>Ship it: B wins 9 tasks, loses 0</code>,
    <code>Hold: not enough evidence</code>, or <code>Don't ship: B breaks 3 tasks A solved</code>. It exits 0 only for "Ship it".
  </p>
  <p>
    A break costs two fixes (<code>--lambda</code>), the wins must clear a one-sided exact test (<code>--gate-alpha</code>, default 0.05), and
    B may break at most 10% of the tasks A solved (<code>--tau</code>). This is the SAGE accept-or-abstain rule
    (<a href="https://arxiv.org/abs/2609.36043">arXiv 2609.36043</a>). Passes that tampered with tests count as fails.
  </p>

  <h2 id="options">More compare options</h2>
  <div class="doc-table">
    <table>
      <thead><tr><th>Flag</th><th>What it adds</th></tr></thead>
      <tbody>
        <tr><td><code>--gate --by suite:</code></td><td>Also gates each group of tasks; any group's "Don't ship" blocks.</td></tr>
        <tr id="promote"><td><code>--promote</code></td><td>Exits 0 only when B is credibly better, or cheaper within <code>--eps-q</code> of A's pass rate.</td></tr>
        <tr id="audited"><td><code>--audited</code></td><td>Counts passes a witness refuted as fails. Needs every pass audited.</td></tr>
        <tr id="item-gate"><td><code>--item-gate</code></td><td>Exits 0 on KEEP or ACCEPT from the one-item gate (when B adds or removes one item).</td></tr>
        <tr id="plugins"><td><code>--with plugin:terse</code></td><td>B is A plus a Claude Code plugin. Your Claude config is never changed.</td></tr>
        <tr id="reuse"><td><code>--reuse baseline</code></td><td>Copies A's finished runs from earlier comparisons, so the baseline is paid for once.</td></tr>
        <tr id="iterate"><td><code>--experiment exp_01 --retry-errors</code></td><td>Reruns, in place, the runs that errored or failed on infrastructure.</td></tr>
        <tr><td><code>--failing exp_01</code></td><td>Runs only the tasks A failed in that comparison.</td></tr>
        <tr id="repair"><td><code>--repair 2</code></td><td>Tells the agent its verifier failed and lets it try again, up to 2 rounds.</td></tr>
        <tr><td><code>--max-cost 15</code></td><td>Stops starting runs once agent and judge spend reach $15.</td></tr>
      </tbody>
    </table>
  </div>
  <details class="more">
    <summary>What else compare reports</summary>
    <ul>
      <li id="tamper">Passing runs that edited, deleted or skipped tests, each linked to the tool call: <code>tampered passes B 3: disclosed 2, stealth 1</code>.</li>
      <li>Each arm's failed runs by the agent's own last test run. Green fails are silent misses: the agent's tests passed and the verifier's did not.</li>
      <li id="release">A note when the arms ran on different agent releases. <code>--promote</code> then holds and exits 1.</li>
      <li>After <code>eval audit</code>: each arm's raw and audited pass rate, as in <code>audited pass B 60% → 30% (3 refuted, coverage 100%)</code>.</li>
    </ul>
    <p>
      The method behind each line, and every flag above, is in <a href={`${GUIDE}#harness-ab`}>Harness A/B</a> and the
      <a href="/docs/cli/compare">compare reference</a>.
    </p>
  </details>

  <div class="note">
    <p>
      <strong>Known gap.</strong> A hook-captured session starts from the commit that was checked out when it began, so uncommitted changes at
      that point are missing and <code>eval new</code> warns. <code>coding.sh run --</code> snapshots the whole working tree before and after.
    </p>
  </div>
</DocsLayout>
