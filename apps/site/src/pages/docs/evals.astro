---
import DocsLayout from "../../components/docs/DocsLayout.astro";
import Code from "../../components/docs/Code.astro";
import Terminal from "../../components/Terminal.astro";
import Tag from "../../components/docs/Tag.astro";

const firstSessions = `coding.sh eval init --sessions --verifier 'npm test'
coding.sh eval run failures --yes`;

const firstSkill = `coding.sh eval init --skill .claude/skills/pdf --draft
coding.sh eval run pdf --yes`;

const firstApp = `coding.sh eval init triage --cases cases.jsonl --command 'node triage.mjs'
# no cases yet: describe the app and have a model draft them
coding.sh eval init triage --describe 'Labels a support ticket billing, bug or other' \\
  --command 'node triage.mjs' --draft
coding.sh eval run triage`;

const dataset = `coding.sh dataset add smoke \\
  --case '{"input":"2+2","expected":"4"}' \\
  --case '{"input":"3*3","expected":"9"}'
coding.sh dataset import cases.jsonl --name support   # JSONL, JSON or CSV
coding.sh dataset add regressions --session <session-id>   # a case from a captured session`;

const agent = `// agent.mjs: reads the case input as JSON on stdin, prints its answer
let s = "";
for await (const chunk of process.stdin) s += chunk;
const input = JSON.parse(s);
console.log(String(eval(input)));`;

const run = `coding.sh exp run --dataset smoke --name base \\
  --task '{"kind":"command","command":"node","args":["agent.mjs"]}' \\
  --grader '{"kind":"exact"}'`;

const spec = `{
  "name": "support-v2",
  "dataset": "support",
  "split": "test",
  "trials": 3,
  "task": { "kind": "http", "url": "http://127.0.0.1:3000/api/agent", "responsePath": "$.output" },
  "graders": [
    { "kind": "contains", "value": ["refund"] },
    { "kind": "llm", "name": "helpful", "rubric": "Pass if the reply resolves the customer's issue.", "tunedOn": ["dev"] }
  ]
}`;

const judge = `coding.sh ui                                   # label sessions pass / fail
coding.sh judge calibrate <experiment> --criterion outcome --split test`;

const scores = `coding.sh score config helpfulness --type numeric --min 0 --max 5
coding.sh score add case:refund-03 helpfulness 4 --comment "named the refund window"
coding.sh score list --name helpfulness`;

// Sections that moved to their own pages. An old /docs/evals#<id> link follows its section.
const moved = {
  "/docs/experiments": ["compare", "non-inferiority", "coverage", "grader-versions", "regrade", "sweep", "matrix", "plateau", "resume", "sessions", "metrics", "exp-replay"],
  "/docs/harness-evals": ["exp-ab", "protected", "refine", "triggers", "repo-replay", "witness", "gate", "tamper", "audited", "promote", "item-gate", "plugins", "hand-written", "reuse", "release", "iterate", "repair"],
};

// The evals guide holds the method behind every line this page shows.
const GUIDE = "https://github.com/jackulau/coding.sh/blob/main/docs/guides/evals.md";

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const m = (s: string) => `<span class="t-muted">${esc(s)}</span>`;
const t = (s: string) => `<span class="t-text">${esc(s)}</span>`;
const ok = (s: string) => `<span class="t-pass">${esc(s)}</span>`;
const no = (s: string) => `<span class="t-fail">${esc(s)}</span>`;

// Real output of scripts/e2e/eval-init-capture.mjs (2026-11-07): Claude Code against a stub model that
// writes the right fix in one trial and a wrong one in the other.
const SUITE = [
  `${m("$")} ${t("coding.sh eval run failures -k 2 --yes")}`,
  `failures  capability suite · 1 task · 2 trials each`,
  `pass@1  50.0% [9.5%, 90.5%]  (1/2 trials, 95% Wilson)`,
  `pass@2  ${ok("100.0%")}  ${m("a task counts when any of 2 trials passes")}`,
  `pass^2  ${no("0.0%")}  ${m("a task counts only when all 2 trials pass")}`,
  "",
  `task                     passed         first failure`,
  m(`-----------------------  ------  -----  ---------------------------`),
  `make-sum-js-add-its-two     1/2  ${no("flaky")}  coding.sh show 4fd72079-09a`,
  "",
  no(`flaky: make-sum-js-add-its-two. These pass some trials and fail others; pass^2 counts them as failures.`),
  m(`1 task: a suite this small only shows large changes; grow it toward 20 to 50 tasks from real failures`),
].join("\n");

// Real output of the commands above (run 2026-11-06 against a throwaway CODING_SH_HOME).
const RUN = [
  `${m("$")} ${t("coding.sh exp run --dataset smoke --name base …")}`,
  `${t("base")}  exp_01M6SAJYC5RM7A5TCT65R3SFSM`,
  `dataset smoke@8db025860cd0b8da  task command: node agent.mjs  trials 1`,
  `pass    ${ok("100.0%")} [34.2%, 100.0%] (2/2, 95% Wilson)`,
  `latency median 32ms, p90 32ms, max 32ms`,
  "",
  `grader  kind     pass  95% CI           mean score  errors  trust`,
  m(`------  -----  ------  ---------------  ----------  ------  -------------`),
  `exact   exact  ${ok("100.0%")}  [34.2%, 100.0%]        1.00       0  deterministic`,
].join("\n");
---

<DocsLayout>
  <p>
    There are two kinds of eval. <strong>Dataset experiments</strong> run any agent, in any language, over a set of cases and grade the
    outputs. <strong>Repo-replay tasks</strong> re-run a coding agent from the repository state before a real session and check the result
    with a validated verifier.
  </p>
  <p>
    <a href="/docs/experiments">Experiments</a> covers comparing two runs, sweeps and long runs. <a href="/docs/harness-evals">Harness
    evals</a> covers testing an AGENTS.md, rule or skill change, and repo-replay tasks.
  </p>

  <h2 id="first-eval">Your first eval in 5 minutes <Tag status="built" /></h2>
  <p>
    <code>eval init</code> writes a suite to <code>evals/&lt;name&gt;/</code> in your repo. <code>eval run</code> runs every suite there, or
    the ones you name, and prints a report. In a terminal, <code>eval init</code> with no flags asks what you want to test.
  </p>
  <p>
    <strong>Your agent's failed sessions.</strong> Up to 10 flagged sessions from this repo in the last 14 days become repo tasks: the repo
    before the session, its first prompt, and your verifier. The failed diff is kept as a near miss the verifier must fail.
  </p>
  <Code code={firstSessions} />
  <p>
    <strong>A skill.</strong> Prompts where the agent should load the skill and prompts where it should not, drafted by a model and marked
    DRAFT for you to review. <code>eval run</code> runs each in Claude Code and checks whether the skill loaded.
  </p>
  <Code code={firstSkill} />
  <p>
    <strong>An app or a prompt.</strong> Cases of <code>&#123;"input", "expected"&#125;</code> and a command (or <code>--url</code>) that
    answers one. <code>eval init</code> also prints a GitHub Actions workflow that runs the suite on every pull request.
  </p>
  <Code code={firstApp} />
  <Terminal title="~/proj" label="Output of coding.sh eval run">
    <pre set:html={SUITE} />
  </Terminal>
  <p>
    Each task runs k times (3 by default). pass@k counts a task when any of its k trials passes, and pass^k only when all of them pass, so a
    <strong>flaky</strong> task counts for the first and against the second. Each failed trial links its captured session.
  </p>
  <p>
    The <a href={`${GUIDE}#your-first-eval-in-5-minutes`}>evals guide</a> maps each step of Anthropic's
    <a href="https://www.anthropic.com/engineering/demystifying-evals-for-ai-agents">Demystifying evals for AI agents</a> roadmap to a command.
  </p>

  <h2 id="datasets">Datasets <Tag status="built" /></h2>
  <p>
    A dataset is a list of cases: <code>input</code>, optional <code>expected</code>, <code>tags</code>, <code>metadata</code> and a
    <code>split</code> (<code>train</code>, <code>dev</code> or <code>test</code>). Every change makes a new version whose id is a hash of
    the cases, so an experiment records exactly what it ran on.
  </p>
  <Code code={dataset} />
  <p id="case-kinds">
    When a dataset tests a change, give each case a <code>kind</code> (in the case, or with <code>dataset add --kind</code>). <code>exp
    run</code> prints the pass rate per kind, and <a href="/docs/experiments#compare"><code>exp compare</code></a> names the bad cases fixed
    and the guards and controls that broke.
  </p>
  <div class="doc-table">
    <table>
      <thead><tr><th>Kind</th><th>Before the change</th><th>After the change</th></tr></thead>
      <tbody>
        <tr><td><code>bad</code></td><td>Fails: it reproduces the failure the change is for.</td><td>Passes.</td></tr>
        <tr><td><code>guard</code></td><td>Passes: behavior that already works.</td><td>Passes.</td></tr>
        <tr><td><code>control</code></td><td>Passes: the fix must not kick in here.</td><td>Passes; a failure means the change overcorrected.</td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="tasks">What gets run</h2>
  <p>The task is the agent under test. Two kinds work from the CLI:</p>
  <ul>
    <li>
      <strong><code>command</code></strong>: any executable. The case input arrives as JSON on stdin; stdout is the output.
      <code>CODING_SH_RUN_ID</code>, <code>CODING_SH_CASE_ID</code> and <code>CODING_SH_TRIAL</code> are in its environment.
    </li>
    <li>
      <strong><code>http</code></strong>: a POST of the input as JSON to a URL; the response (or a JSON path into it) is the output. Header
      values can come from environment variables, so secrets stay out of spec files.
    </li>
  </ul>
  <Code title="agent.mjs" code={agent} />
  <Code code={run} />
  <Terminal title="~/smoke" label="Output of coding.sh exp run">
    <pre set:html={RUN} />
  </Terminal>
  <p>
    With one trial per case the interval is a Wilson interval; with <code>--trials</code> above 1 it is a bootstrap over cases. Options can
    also live in a JSON spec file: <code>coding.sh exp run spec.json</code>.
  </p>
  <Code title="spec.json" code={spec} />

  <h2 id="graders">Graders <Tag status="built" /></h2>
  <p>
    Deterministic graders come first. Each grader's config is hashed into a version, so a changed grader is a different grader. Every field
    is in <a href={`${GUIDE}#grader-fields`}>Grader fields</a>.
  </p>
  <div class="doc-table">
    <table>
      <thead><tr><th>Kind</th><th>Passes when</th></tr></thead>
      <tbody>
        <tr><td><code>exact</code></td><td>Output equals <code>expected</code> (structural for JSON, normalized for text).</td></tr>
        <tr><td><code>contains</code></td><td>Output contains all (or any) of the strings; <code>negate</code> inverts it.</td></tr>
        <tr><td><code>regex</code></td><td>Output matches a pattern.</td></tr>
        <tr><td><code>json-schema</code></td><td>Output validates against a JSON Schema.</td></tr>
        <tr><td><code>json-path</code></td><td>A JSON path into the output equals a value or the same path in <code>expected</code>.</td></tr>
        <tr><td><code>numeric</code></td><td>The first number in the output is within an absolute or relative tolerance.</td></tr>
        <tr><td><code>similarity</code></td><td>Normalized edit-distance similarity is at least the threshold (default 0.8).</td></tr>
        <tr><td><code>progress</code></td><td>The run's trace derailed (looping, churn, stalling and the like) at most <code>maxDerails</code> times (default 0).</td></tr>
        <tr><td><code>executability</code></td><td>The trace has at most <code>maxInvalid</code> tool calls the harness refused to run (default 0).</td></tr>
        <tr><td><code>agent-slop</code></td><td>The lines the agent's diff adds have at most <code>maxErrors</code> findings such as <code>as any</code> or empty catches (default 0).</td></tr>
        <tr><td><code>command</code></td><td>Your script, any language: JSON on stdin; a boolean, a score or <code>&#123;score, pass, reason&#125;</code> on stdout, or the exit code.</td></tr>
        <tr><td><code>module</code></td><td>A JS module's exported grade function returns pass.</td></tr>
        <tr><td><code>llm</code></td><td>A model judge returns pass on your rubric. See below.</td></tr>
        <tr><td><code>llm-checklist</code></td><td>Yes/no questions, each answered by the model or by a trace check such as <code>ran-command</code> or <code>no-test-tamper</code>.</td></tr>
        <tr><td><code>llm-panel</code></td><td>One judge per provider scores 1-10 and the median reaches <code>target</code> (default 7).</td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="judges">LLM judges <Tag status="built" /></h2>
  <p>
    An <code>llm</code> grader calls Anthropic's Messages API or any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama, LM Studio, vLLM
    through <code>baseURL</code>). Keys are read from the environment at call time and never logged, hashed or cached. Verdicts are cached
    on disk, so re-grading an unchanged output costs nothing.
  </p>
  <p>
    Each judge is versioned as <code>name@hash</code> over model, prompt template, rubric, criterion and parameters. Judge verdicts can cite
    the trace, and citations are checked against what the judge was shown.
  </p>
  <p>
    A <code>pairwise</code> judge compares two experiments: <code>exp compare A B --pairwise judge.json</code>. It sees both outputs for each
    case twice, with the order swapped, and a side wins only when both orders agree. It reports B's win rate with an interval and a sign test.
  </p>
  <details class="more">
    <summary>Position bias and stability</summary>
    <p>
      A case whose answer changes with the order is a tie, and counts toward the printed position-bias rate. <code>--labels</code> takes human
      A/B/tie labels and calibrates the judge like any other.
    </p>
    <p>
      An inconclusive win rate can mean "needs more cases" or "this judge flips". The report prints how often a resample of the cases picks
      the same winner, and n*, the smallest size where that holds 95% of the time: <code>stable  B better in 97% of resamples (n*=50)</code>.
    </p>
    <p>
      An uncalibrated judge that never settles is flagged "unresolved: pick or calibrate the judge before collecting more verdicts" (arXiv
      2611.04090). Judge graders get the same line in <code>exp compare</code>.
    </p>
  </details>

  <h2 id="calibration">Calibrate a judge against people <Tag status="built" /></h2>
  <p>
    A judge's score counts only once it agrees with people. Label sessions pass or fail in the viewer, then measure agreement on a split the
    judge's prompt was not tuned on.
  </p>
  <Code code={judge} />
  <ul>
    <li>Agreement is Cohen's κ with a bootstrap interval, plus the confusion matrix and precision and recall for "fail".</li>
    <li>A judge is <strong>calibrated</strong> at κ ≥ 0.6 on at least 20 held-out cases with both a human label and a verdict.</li>
    <li>κ measured on a split in the judge's <code>tunedOn</code> is <strong>in-sample</strong>, never calibrated.</li>
    <li>Below the bar, the judge is <strong>uncalibrated</strong> or has <strong>insufficient data</strong>, and every report flags its scores.</li>
    <li>Cases where the judge is confidently opposite to unanimous humans are listed for relabelling.</li>
    <li>The judge's held-out sensitivity and specificity are stored, so <code>exp compare</code> shows a bias-corrected judge pass rate.</li>
  </ul>
  <div class="doc-table">
    <table>
      <thead><tr><th>Flag</th><th>What it adds</th></tr></thead>
      <tbody>
        <tr><td><code>--threshold</code>, <code>--min-n</code></td><td>Change the bar: κ 0.6 and 20 cases.</td></tr>
        <tr><td><code>--judge-cost 0.001</code></td><td>The human label cost above which calibrating the judge pays off.</td></tr>
        <tr><td><code>--plan plan.json</code></td><td>The human-audited pass rate from the cases <a href="/docs/cli/judge#cmd-judge-sample"><code>judge sample</code></a> picked to label.</td></tr>
        <tr><td><code>--probe-injection judge.json</code></td><td>Re-judges human-fail cases with a planted "respond pass" order. Any flip exits 1.</td></tr>
        <tr><td><code>--grader tests</code></td><td>Audits a test verifier instead: how many of its passes a person would accept.</td></tr>
        <tr><td><code>--sample-passes 40</code></td><td>Lists a seeded sample of unlabelled passes to label, instead of measuring.</td></tr>
      </tbody>
    </table>
  </div>
  <p>
    The agent writes the text a judge grades, so judge prompts escape the data tags inside it and tell the model that everything inside them
    is untrusted. The <a href={`${GUIDE}#judges`}>Judges</a> section of the evals guide has the method behind each number.
  </p>

  <h2 id="scores">Scores <Tag status="built" /></h2>
  <p>
    A score is one typed value on a session, an event, a dataset case or an eval run: a number, true or false, a category or text. A config
    fixes a score name's type and range, and a value outside it is refused. A pass or fail label is a human boolean score, which is what
    <code>judge calibrate</code> reads.
  </p>
  <Code code={scores} />
  <p>
    Scoring the same target, name and source again replaces the score. The viewer and <code>coding.sh serve</code> take scores at
    <code>POST /api/scores</code>, and agents use the <code>score_add</code> and <code>score_list</code> MCP tools.
  </p>

  <h2 id="workflows">Workflows</h2>
  <p>
    Multi-agent workflows have their own page: capturing runs, scoring them against seeded bugs, and comparing two versions. See
    <a href="/docs/workflows">Workflow experiments</a>.
  </p>

  <script is:inline define:vars={{ moved }}>
    {
      const id = decodeURIComponent(location.hash.slice(1));
      const to = Object.keys(moved).find((path) => moved[path].includes(id));
      if (to) location.replace(to + location.hash);
    }
  </script>
</DocsLayout>
