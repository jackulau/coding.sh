const agentsPy = `from agents import Agent, Runner, function_tool
from openinference.instrumentation.openai_agents import OpenAIAgentsInstrumentor
from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter
from opentelemetry.sdk.resources import Resource
from opentelemetry.sdk.trace import TracerProvider
from opentelemetry.sdk.trace.export import BatchSpanProcessor

provider = TracerProvider(resource=Resource.create({"service.name": "coding-sh-triage"}))
provider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter(endpoint="http://127.0.0.1:4318/v1/traces")))
OpenAIAgentsInstrumentor().instrument(tracer_provider=provider)  # also replaces OpenAI's own trace upload

@function_tool
def list_labels() -> list[str]:
    """The repo's labels."""
    return ["bug", "cli", "docs", "sdk", "viewer"]

agent = Agent(
    name="triage",
    instructions="Pick labels for this GitHub issue. Call list_labels first. Answer with the labels only.",
    model="gpt-5-mini",
    tools=[list_labels],
)
result = Runner.run_sync(agent, "Viewer search misses tool output")
print(result.final_output)
provider.shutdown()  # sends the spans before the script exits`;

