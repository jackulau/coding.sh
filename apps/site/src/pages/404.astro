---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Mark from "../components/Mark.astro";
---

<Layout title="Page not found · coding.sh" description="This page does not exist on coding.sh." noindex>
  <Nav />
  <main id="main" class="wrap nf">
    <Mark size={44} />
    <h1>Page not found</h1>
    <p>Nothing lives at this address.</p>
    <div class="nf__links">
      <a href="/" class="btn btn-primary">Home</a>
      <a href="/docs" class="btn">Docs</a>
    </div>
  </main>
</Layout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 70dvh;
    padding-top: var(--nav-h);
    text-align: center;
  }
  .nf h1 {
    margin-top: 1.5rem;
    font-size: clamp(2rem, 1.4rem + 3vw, 3rem);
    letter-spacing: -0.04em;
  }
  .nf p {
    margin-top: 0.75rem;
    color: var(--text-2);
  }
  .nf__links {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
