---
// The front page. Its body, its two pictures and the click predictor are plain HTML and JS in
// src/landing; this file holds the page's data and fills it into the body's {{PLACEHOLDER}}s.
// The pictures are drawings; the screenshot and the numbers are the site's own.
//
// The same page in another language is src/pages/[lang]/index.astro, which renders this one with
// a `lang`: every string goes through the translation table in src/i18n/home/<lang>.ts.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Mark from "../components/Mark.astro";
import Wordmark from "../components/Wordmark.astro";
import { SITE, INSTALL_SH, REPO_URL, LICENSE_URL, RELEASE } from "../data/site";
import { releasePath, slug } from "../lib/changelog";
import { STATS } from "../data/compare";
import usage from "../data/usage-rows.json";
import { logo } from "../lib/logos";
import { faqSchema } from "../lib/schema";
// The viewer screenshot goes through the asset pipeline, so a build serves it too.
import shot from "../assets/product/hero-session.webp";
import shotM from "../assets/product/hero-session-m.webp";
import body from "../landing/body.html?raw";
import scene from "../landing/trace.html?raw";
import flow from "../landing/flow.html?raw";
import intentCore from "../landing/intent-core.js?raw";
import intentWire from "../landing/intent-wire.js?raw";
import { pack } from "../landing/pack";
import { getImage } from "astro:assets";
import { LOCALES, localeOf } from "../i18n/locales.mjs";
import { translator } from "../i18n/home";

interface Props {
  /** A code from src/i18n/locales.mjs; English when absent. */
  lang?: string;
}
const locale = localeOf(Astro.props.lang);
const { t, html: tr } = translator(locale.code);

// Agents with an adapter (packages/coding.sh/src/adapters; table in components/docs/agents.ts),
// each with the site's own mark (src/lib/logos). An agent with no published logo gets the
// site's neutral prompt glyph.
const WORKS_WITH = [
  { id: "claude-code", name: "Claude Code" },
  { id: "codex", name: "Codex" },
  { id: "cursor", name: "Cursor" },
  { id: "opencode", name: "OpenCode" },
  { id: "antigravity", name: "Antigravity CLI" },
  { id: "copilot-cli", name: "GitHub Copilot" },
  { id: "amp", name: "Amp" },
  { id: "goose", name: "Goose" },
  { id: "pi", name: "Pi" },
  { id: "droid", name: "Factory Droid" },
  { id: "aider", name: "Aider" },
  { id: "t3code", name: "T3 Code" },
];
const GLYPH = { viewBox: "0 0 24 24", evenodd: false, body: '<path d="M4.5 7.5 9 12l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/><path d="M12 17.25h7.5" fill="none" stroke="currentColor" stroke-width="1.8"/>' };
// The name is written next to each mark, so the mark itself is decoration.
const mark = (id: string) => {
  const l = logo(id) ?? GLYPH;
  return `<svg viewBox="${l.viewBox}" fill="currentColor"${l.evenodd ? ' fill-rule="evenodd"' : ""} aria-hidden="true" focusable="false">${l.body}</svg>`;
};
const works = WORKS_WITH.map(({ id, name }) => `<li>${mark(id)}${name}</li>`).join("\n");

const w = usage.head.map((h: string, i: number) => Math.max(h.length, ...usage.rows.map((r: string[]) => r[i].length)));
const row = (r: string[]) => r.map((c, i) => (i === r.length - 1 ? c : c.padEnd(w[i]) + "  ")).join("");
const USAGE = [`<span class="t">$ ${usage.command}</span>`, `<span class="t">${row(usage.head)}</span>`, ...usage.rows.map(row)].join("\n");

// The questions, once: the page lists them and the FAQ structured data repeats them.
const FAQ = [
  { q: "Does anything leave my machine?", a: "No session data. The only default request is a daily update check (off with CODING_SH_NO_UPDATE_CHECK=1). Sessions are saved in ~/.coding.sh and nothing else is sent unless you set up an export yourself." },
  { q: "Will it slow my agent down?", a: "No. The hook adds one line to a file and exits. The rest of the work happens after the session." },
  { q: "Does it change my agent's settings?", a: "Only after you say yes. It backs up each file first, and coding.sh uninstall takes its hooks out again." },
  { q: "What does it cost?", a: "Nothing. Your model spend stays what your agents already cost." },
];
const esc = (t: string) => t.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
const QA = FAQ.map(({ q, a }) => ({ q: t(q), a: t(a) }));
const faq = QA.map(({ q, a }) => `<details>\n<summary>${esc(q)}</summary>\n<p>${esc(a)}</p>\n</details>`).join("\n");

const tiles = WORKS_WITH.map(({ id, name }) => `<li class="f-tile" title="${name}">${mark(id)}</li>`).join("\n");
const intent = `<script>\n(() => {\n${intentCore}\n${intentWire}})();\n</scr` + `ipt>`;
// FLOW goes first: it carries a placeholder of its own. Each value goes in through a function,
// so a "$" in it is kept as written.
// The screenshots are 2x captures. Each also gets a 1x file, so a 1x screen does not download
// the 2x one: 777px is the widest the desktop slot gets (two thirds of the 76rem frame, less its
// padding), and the phone crop is drawn at half its pixel width.
const desk = await getImage({ src: shot, widths: [777, shot.width], format: "webp", quality: 82 });
const phone = await getImage({ src: shotM, widths: [shotM.width / 2, shotM.width], format: "webp", quality: 82 });
const fill: Record<string, string> = { FLOW: tr(flow), INTENT: intent, AGENT_TILES: tiles, SCENE: tr(scene), WORKS: works, FAQ: faq, USAGE, SHOT: desk.src, SHOT_SET: desk.srcSet.attribute, SHOT_M_SET: phone.srcSet.attribute, INSTALL: INSTALL_SH, RELEASE, RELEASE_HREF: releasePath(slug(RELEASE)), BASE_RATE: String(STATS.baseRate), CAND_RATE: String(STATS.candRate), TASKS: String(STATS.tasks), RUNS: String(STATS.runsPerTask) };
// The footer's links, in columns. Every one is a page that exists.
const FOOT: [string, [string, string][]][] = [
  ["Start", [["Quickstart", "/docs/quickstart"], ["Install", "/docs/install"], ["Agents", "/docs/agents"], ["All docs", "/docs"]]],
  ["Use", [["Cost", "/docs/cost"], ["Evals", "/docs/evals"], ["Experiments", "/docs/experiments"], ["SDK", "/docs/sdk"]]],
  ["Project", [["Changelog", "/changelog"], ["Blog", "/blog"], ["GitHub", REPO_URL], ["License", LICENSE_URL]]],
  ["More", [["Compare", "/docs/compare"], ["Privacy", "/docs/privacy"], ["FAQ", "/docs/faq"], ["llms.txt", "/llms.txt"]]],
];
const html = pack(Object.entries(fill).reduce((s, [k, v]) => s.replaceAll(`{{${k}}}`, () => v), tr(body)));
---

<Layout
  title={t(`${SITE.name}: open-source observability and evals for AI agents`)}
  description={t(`Record what Claude Code, Codex, Cursor and ${WORKS_WITH.length - 3} other AI agents did and what it cost, then test changes with evals. Local-first and open source.`)}
  schemas={[faqSchema(QA, locale.tag)]}
  locale={locale}
  alternates={LOCALES}
>
  <Nav lang={locale.code} />
  <Fragment set:html={html} />
  <footer slot="footer" class="site-footer f-foot">
    <div class="f-foot__frame">
      <div class="f-foot__top">
        <div class="f-foot__id">
          <a href={locale.path} aria-label={t("coding.sh home")} class="f-foot__brand"><Mark size={18} /><Wordmark /></a>
          <p>{t("A record of what your agents did and what it cost, kept on your machine.")}</p>
          <dl class="f-foot__fine">
            <div><dt>{t("status")}</dt><dd>{SITE.version.replace("early", t("early"))}</dd></div>
          </dl>
          {/* The page in each language. A full load, not the client router: the <html lang> and
              the head's alternates change with it. The names are drawn in the system font: Geist's
              core file has no ç, ê or ñ, and without this every page would fetch the -rest file
              for "Français", "Português" and "Español" (scripts/perf-budget.mjs, rule 5). */}
          <nav aria-label={t("Language")} class="f-foot__langs" data-system-font>
            <ul role="list">
              {LOCALES.map((l) => (
                <li><a href={l.path} hreflang={l.tag} lang={l.tag} aria-current={l === locale ? "page" : undefined} data-astro-reload>{l.name}</a></li>
              ))}
            </ul>
          </nav>
        </div>
        <nav aria-label={t("Footer")} class="f-foot__nav">
          {FOOT.map(([head, links]) => (
            <div>
              <h2>{t(head)}</h2>
              <ul role="list">
                {links.map(([name, href]) => <li><a href={href}>{t(name)}</a></li>)}
              </ul>
            </div>
          ))}
        </nav>
      </div>
      {/* The wordmark again, as large as the frame, fading out at the bottom. Decoration only. */}
      <div class="f-foot__big" aria-hidden="true"><Wordmark px={20} /></div>
    </div>
  </footer>
</Layout>

<style>
  /* The footer carries on between the page's two rails. */
  .f-foot {
    --rail: var(--line-strong, #2c2c30);
    padding-inline: var(--gutter, 1rem);
    font-size: 0.9375rem;
  }
  .f-foot__frame {
    position: relative;
    max-width: 76rem;
    margin-inline: auto;
    overflow: hidden;
    border-inline: 1px solid var(--rail);
  }
  .f-foot__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
  }
  .f-foot__id {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 3.25rem 2rem 2.5rem;
  }
  .f-foot__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
  }
  .f-foot__id p {
    max-width: 17rem;
    margin: 0;
    line-height: 1.5;
    color: var(--text-2);
  }
  .f-foot__fine {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.4rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs, 12px);
  }
  .f-foot__fine div {
    display: flex;
    gap: 0.45rem;
    white-space: nowrap;
  }
  .f-foot__fine dt {
    color: var(--text-muted);
  }
  .f-foot__fine dd {
    margin: 0;
    color: var(--text-2);
  }
  nav[data-system-font] {
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .f-foot__langs ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm, 0.875rem);
  }
  .f-foot__langs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--text-muted);
    transition: color 200ms ease;
  }
  .f-foot__langs a[aria-current] {
    color: var(--text);
  }
  .f-foot__langs a:active {
    color: var(--text);
    transition-duration: 0s;
  }
  @media (hover: hover) and (pointer: fine) {
    .f-foot__langs a:hover {
      color: var(--text);
      transition-duration: 90ms;
    }
  }
  @media (pointer: coarse) {
    .f-foot__langs a {
      min-height: 2.75rem;
    }
  }
  /* Chinese, Japanese and Korean: the Latin headings' tight tracking crowds the characters.
     Japanese breaks lines between phrases where the browser can tell them apart; Korean, which
     puts spaces between words, breaks only at those spaces. */
  :global(:is(:lang(zh), :lang(ja), :lang(ko)) .f :is(h1, h2, h3)) {
    letter-spacing: 0;
  }
  :global(:lang(ja) .f) {
    word-break: auto-phrase;
  }
  :global(:lang(ko) .f) {
    word-break: keep-all;
  }
  .f-foot__nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    padding: 3.5rem 2rem 2.5rem 0;
  }
  .f-foot__nav h2 {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .f-foot__nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .f-foot__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--text-2);
    transition: color 200ms ease;
  }
  .f-foot__nav a:active {
    color: var(--text);
    transition-duration: 0s;
  }
  @media (hover: hover) and (pointer: fine) {
    .f-foot__nav a:hover {
      color: var(--text);
      transition-duration: 90ms;
    }
  }
  @media (pointer: coarse) {
    .f-foot__nav a {
      min-height: 2.75rem;
    }
  }
  .f-foot__big {
    padding: 1rem 2rem 0;
    margin-bottom: calc(-1.4% + var(--safe-b, 0px));
    opacity: 0.11;
    -webkit-mask-image: linear-gradient(#000 10%, transparent 96%);
    mask-image: linear-gradient(#000 10%, transparent 96%);
  }
  .f-foot__big :global(svg) {
    width: 100%;
    height: auto;
  }
  @media (max-width: 767px) {
    .f-foot {
      padding-inline: 0;
    }
    .f-foot__frame {
      border-inline: 0;
    }
    .f-foot__top {
      grid-template-columns: minmax(0, 1fr);
    }
    .f-foot__id {
      padding: 2.5rem 1.25rem 0.5rem;
    }
    .f-foot__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 1.75rem 1.25rem 2rem;
    }
    .f-foot__big {
      padding-inline: 1.25rem;
    }
  }
</style>
