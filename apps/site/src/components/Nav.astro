---
// Site nav. At the top of the page it sits flat and full-width over the hero;
// once the page scrolls it becomes a floating pill: near-black, a 1px hairline,
// a little blur. Only opacity and transform animate, and nothing does under
// reduced motion. Mark and pixel wordmark on the left, links in the centre,
// Source and the HUMAN | AGENT switch on the right. The switch itself lives in
// ViewToggle.astro (it must outlive the nav in the agent view); the nav only
// reserves its slot, and the switch is docked over that slot. Under 880px the
// links and Source fold into a small menu that works without JS (<details>).
import Wordmark from "./Wordmark.astro";
import Mark from "./Mark.astro";
import GitHubIcon from "./GitHubIcon.astro";
import { REPO_URL } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const LINKS = [
  { href: "/docs", label: "Docs", on: (p: string) => p === "/docs" || (p.startsWith("/docs/") && p !== "/docs/agents") },
  { href: "/docs/agents", label: "Agents", on: (p: string) => p === "/docs/agents" },
  { href: "/changelog", label: "Changelog", on: (p: string) => p === "/changelog" },
];
const links = LINKS.map((l) => ({ ...l, current: l.on(path) }));
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <a href="/" class="nav__home" aria-label="coding.sh home">
      <Mark size={20} />
      <Wordmark />
    </a>

    <nav aria-label="Primary" class="nav__links">
      {links.map((l) => <a href={l.href} class="nav__link" aria-current={l.current ? "page" : undefined}>{l.label}</a>)}
    </nav>

    <div class="nav__end">
      <a href={REPO_URL} class="nav__src">
        <GitHubIcon />
        Source
      </a>
      <span class="nav__tog-slot" aria-hidden="true"></span>
      <details class="nav__menu" data-nav-menu>
        <summary class="nav__menu-btn" aria-label="Menu">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M2.5 5.5h11M2.5 10.5h11" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </summary>
        <nav aria-label="Menu" class="nav__menu-list">
          {links.map((l) => <a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a>)}
          <a href={REPO_URL}>Source</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    --inset: 1rem;
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    pointer-events: none;
  }
  .nav__bar {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 76rem;
    height: 3.5rem;
    margin: 0 auto;
    padding-inline: calc(var(--inset) + 1rem);
    pointer-events: auto;
    transition: transform 180ms var(--ease-out);
  }
  @media (min-width: 640px) {
    .nav {
      --inset: 1rem;
    }
    .nav__bar {
      padding-inline: 2rem;
    }
  }
  /* The pill: its own layer, so showing it is an opacity + scale change. */
  .nav__bar::before {
    content: "";
    position: absolute;
    inset: 0 var(--inset);
    z-index: -1;
    border-radius: 16px;
    background: rgba(10, 10, 11, 0.8);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.09),
      0 12px 32px -12px rgba(0, 0, 0, 0.8);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 180ms ease-out,
      transform 180ms var(--ease-out);
  }
  @media (min-width: 640px) {
    .nav__bar::before {
      inset: 0 1rem;
    }
  }
  .nav.is-scrolled .nav__bar {
    transform: translateY(0.5rem);
  }
  .nav.is-scrolled .nav__bar::before {
    opacity: 1;
    transform: none;
  }

  .nav__home {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.75rem;
    justify-self: start;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.8rem;
    font-size: var(--fs-base);
    color: var(--text-2);
    transition: color 150ms ease;
  }
  .nav__link[aria-current="page"] {
    color: var(--text);
  }
  .nav__end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: end;
  }
  .nav__src {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.375rem;
    padding: 0 0.9rem;
    border-radius: 11px;
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--text);
    background: #141416;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.11);
    transition:
      background-color var(--hover-out) ease,
      transform 140ms var(--ease-out);
  }
  .nav__src:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav__link:hover {
      color: var(--text);
    }
    .nav__src:hover {
      background: #1c1c1f;
      transition-duration: var(--hover-in);
    }
  }

  /* Room for the docked HUMAN | AGENT switch (ViewToggle.astro), which sits
     exactly over this box. Widths here and there must match. */
  .nav__tog-slot {
    flex: none;
    width: calc(9.5rem + 6px);
    height: 38px;
  }
  @media (max-width: 879px) {
    .nav__tog-slot {
      width: calc(8.5rem + 6px);
    }
  }
  @media (max-width: 399px) {
    .nav__tog-slot {
      width: calc(7rem + 6px);
    }
  }

  /* menu (narrow screens only) */
  .nav__menu {
    position: relative;
    display: none;
  }
  .nav__menu-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 11px;
    color: var(--text-2);
    list-style: none;
    cursor: pointer;
  }
  .nav__menu-btn::-webkit-details-marker {
    display: none;
  }
  .nav__menu[open] .nav__menu-btn {
    color: var(--text);
    background: #141416;
  }
  .nav__menu-list {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    display: flex;
    flex-direction: column;
    min-width: 13rem;
    padding: 0.25rem 0;
    overflow: hidden;
    border-radius: 14px;
    background: #0c0c0d;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 16px 40px -12px rgba(0, 0, 0, 0.9);
    transform-origin: top right;
  }
  /* One surface, plain rows, one hairline between them: no cards in the card. */
  .nav__menu-list a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.875rem;
    padding: 0 1.1rem;
    font-size: 1rem;
    color: var(--text-2);
  }
  .nav__menu-list a + a {
    border-top: 1px solid var(--line);
  }
  .nav__menu-list a:active {
    color: var(--text);
  }
  .nav__menu-list a[aria-current="page"] {
    color: var(--text);
  }
  .nav__menu-list a[aria-current="page"]::after {
    content: "";
    width: 5px;
    height: 5px;
    margin-left: auto;
    background: var(--text);
  }
  .nav__menu-src {
    color: var(--text) !important;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav__menu[open] .nav__menu-list {
      animation: menu-in 150ms var(--ease-out);
    }
  }
  /* Same entrance as the Copy page menu (ViewToggle.astro), from the trigger's corner. */
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(-3px);
    }
  }

  @media (max-width: 879px) {
    .nav__bar {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .nav__links,
    .nav__src {
      display: none;
    }
    .nav__menu {
      display: block;
    }
    .nav__src {
      display: none;
    }
    .nav__end {
      gap: 0.25rem;
      margin-right: -0.5rem;
    }
  }
  @media (max-width: 399px) {
    .nav__bar {
      gap: 0.5rem;
      padding-inline: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__src:active {
      transform: none;
    }
    .nav__bar,
    .nav__bar::before,
    .nav__link,
    .nav__src {
      transition: none;
    }
  }
</style>

<script>
  function setupNav() {
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    if (!nav || nav.dataset.bound) return;
    nav.dataset.bound = "1";
    let ticking = false;
    const update = () => {
      nav.classList.toggle("is-scrolled", scrollY > 8);
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    // Close the menu on outside click or Escape.
    const menu = nav.querySelector<HTMLDetailsElement>("[data-nav-menu]");
    const onDoc = (e: Event) => {
      if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape" && menu?.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    };
    addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener("click", onDoc);
    document.addEventListener("keydown", onKey);
    update();
    document.addEventListener(
      "astro:before-swap",
      () => {
        removeEventListener("scroll", onScroll);
        document.removeEventListener("click", onDoc);
        document.removeEventListener("keydown", onKey);
      },
      { once: true },
    );
  }
  document.addEventListener("astro:page-load", setupNav);
</script>
