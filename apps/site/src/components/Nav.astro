---
// Site nav. At the top of the page it sits flat and full-width over the hero;
// once the page scrolls it becomes a floating pill: near-black, a 1px hairline,
// a little blur. Only opacity and transform animate, and nothing moves under
// reduced motion. Mark and pixel wordmark on the left, links in the centre,
// GitHub on the right.
//
// Under 880px the links, GitHub and the install command move into a sheet
// that opens under the bar. The sheet shares the
// pill's side insets and corner radius, so bar and sheet read as one object.
// It opens from the menu button's corner (opacity + a small translate and
// scale, 200ms ease-out) and closes faster (140ms); both are transitions, so a
// quick second tap reverses it mid-way. Reduced motion: opacity only.
// Esc, a tap outside and a tap on a link close it; focus stays inside while it
// is open and goes back to the button after; the page behind does not scroll.
// Without JS the sheet never opens, so the bar shows the plain links instead.
import Wordmark from "./Wordmark.astro";
import Mark from "./Mark.astro";
import GitHubIcon from "./GitHubIcon.astro";
import CopyIcon from "./CopyIcon.astro";
import { REPO_URL, INSTALL_SH } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const LINKS = [
  { href: "/docs", label: "Docs", on: (p: string) => p === "/docs" || (p.startsWith("/docs/") && !p.startsWith("/docs/compare")) },
  { href: "/docs/compare", label: "Compare", on: (p: string) => p === "/docs/compare" || p.startsWith("/docs/compare/") },
  { href: "/changelog", label: "Changelog", on: (p: string) => p === "/changelog" || p.startsWith("/changelog/") },
  { href: "/blog", label: "Blog", on: (p: string) => p === "/blog" || p.startsWith("/blog/") },
];
const links = LINKS.map((l) => ({ ...l, current: l.on(path) }));
// The install command breaks only before the pipe (see InstallActions).
const [cmdHead, cmdTail] = INSTALL_SH.split(/ (?=\| )/);
---

<header class="nav" data-nav>
  <div class="nav__scrim" data-nav-scrim aria-hidden="true"></div>
  <div class="nav__bar">
    <a href="/" class="nav__home" aria-label="coding.sh home">
      <Mark size={20} />
      <Wordmark />
    </a>

    <nav aria-label="Primary" class="nav__links">
      {links.map((l) => <a href={l.href} class="nav__link" aria-current={l.current ? "page" : undefined}>{l.label}</a>)}
    </nav>

    <div class="nav__end">
      <a href={REPO_URL} class="nav__src">
        <GitHubIcon />
        GitHub
      </a>
      <button type="button" class="nav__menu-btn" aria-expanded="false" aria-controls="nav-sheet" aria-label="Menu" data-nav-btn>
        <span class="nav__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>

    <div class="nav__sheet" id="nav-sheet" data-nav-sheet tabindex="-1" hidden>
      <nav aria-label="Menu" class="nav__group">
        {
          links.map((l) => (
            <a href={l.href} class="nav__row" aria-current={l.current ? "page" : undefined}>
              {l.label}
            </a>
          ))
        }
        <a href={REPO_URL} class="nav__row">
          <span class="nav__row-main"><GitHubIcon /> GitHub</span>
          <svg class="nav__ext" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
            <path d="M4 2.5h5.5V8M9.5 2.5 3 9" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
      </nav>

      <div class="nav__group nav__group--pad">
        <p class="nav__cap">Install</p>
        <button type="button" class="nav__install" data-copy={INSTALL_SH} aria-label={`Copy the install command: ${INSTALL_SH}`}>
          <code><span>{cmdHead}</span>{cmdTail && <>{" "}<span>{cmdTail}</span></>}</code>
          <CopyIcon />
        </button>
        {/* The page's own status line is inert while the sheet is open. */}
        <p class="sr-only" aria-live="polite" data-nav-copy-status></p>
      </div>
    </div>
  </div>
</header>

<style>
  .nav {
    --inset: 1rem;
    --bar-h: 3.5rem;
    --radius-bar: 16px;
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    /* Clear of the notch: the pill's edges sit on the safe-area edges, so
       everything in it is clear. The sheet shares the same insets. */
    padding: var(--safe-t) max(0px, calc(var(--safe-r) - var(--inset))) 0 max(0px, calc(var(--safe-l) - var(--inset)));
    pointer-events: none;
  }
  .nav__bar {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 76rem;
    height: var(--bar-h);
    margin: 0 auto;
    padding-inline: 2rem;
    pointer-events: auto;
    transition: transform 180ms var(--ease-out);
    /* Its own stacking context, so the pill (::before, z-index -1) stays above the scrim. */
    z-index: 1;
  }
  /* The pill: its own layer, so showing it is an opacity + scale change. */
  .nav__bar::before {
    content: "";
    position: absolute;
    inset: 0 var(--inset);
    z-index: -1;
    border-radius: var(--radius-bar);
    /* Near-opaque: text scrolling under the pill must not read through it,
       even where backdrop-filter is unsupported or still compositing. */
    background: rgba(10, 10, 11, 0.94);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.09),
      0 12px 32px -12px rgba(0, 0, 0, 0.8);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 180ms ease-out,
      transform 180ms var(--ease-out);
  }
  .nav.is-scrolled .nav__bar {
    transform: translateY(0.5rem);
  }
  .nav.is-scrolled .nav__bar::before,
  .nav.is-open .nav__bar::before {
    opacity: 1;
    transform: none;
  }
  .nav.is-open .nav__bar::before {
    background: rgba(12, 12, 13, 0.96);
  }

  .nav__home {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.75rem;
    justify-self: start;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.8rem;
    font-size: var(--fs-base);
    color: var(--text-2);
    transition: color 150ms ease;
  }
  .nav__link[aria-current="page"] {
    color: var(--text);
  }
  .nav__end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: end;
  }
  .nav__src {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.375rem;
    padding: 0 0.9rem;
    border-radius: 11px;
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--text);
    background: #141416;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.11);
    transition:
      background-color var(--hover-out) ease,
      transform 140ms var(--ease-out);
  }
  .nav__src:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav__link:hover {
      color: var(--text);
    }
    .nav__src:hover {
      background: #1c1c1f;
      transition-duration: var(--hover-in);
    }
  }

  /* ---------- menu button and sheet (narrow screens only) ---------- */
  .nav__menu-btn,
  .nav__sheet,
  .nav__scrim {
    display: none;
  }
  .nav__menu-btn {
    position: relative;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 11px;
    color: var(--text-2);
    background: transparent;
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      background-color 150ms ease,
      box-shadow 150ms ease,
      color 150ms ease,
      transform 140ms var(--ease-out);
  }
  /* 44px to the touch, 40px to the eye. */
  .nav__menu-btn::after {
    content: "";
    position: absolute;
    inset: -2px;
  }
  .nav__menu-btn:active {
    transform: scale(0.95);
  }
  /* Keep the focus ring inside the pill, on the button's own corners. */
  .nav__menu-btn:focus-visible {
    outline-offset: -2px;
    border-radius: 11px;
  }
  .nav__menu-btn[aria-expanded="true"] {
    color: var(--text);
    background: #161618;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  /* Two lines that turn into a cross. */
  .nav__burger {
    position: relative;
    width: 16px;
    height: 16px;
  }
  .nav__burger i {
    position: absolute;
    left: 1.5px;
    right: 1.5px;
    top: 7.25px;
    height: 1.5px;
    background: currentColor;
    transition: transform 200ms var(--ease-out);
  }
  .nav__burger i:first-child {
    transform: translateY(-2.5px);
  }
  .nav__burger i:last-child {
    transform: translateY(2.5px);
  }
  [aria-expanded="true"] .nav__burger i:first-child {
    transform: rotate(45deg);
  }
  [aria-expanded="true"] .nav__burger i:last-child {
    transform: rotate(-45deg);
  }

  /* Dims the page and catches the outside tap. */
  /* Dark and blurred enough that the hero's install command doesn't read as
     a second copy of the one in the sheet. */
  .nav__scrim {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.84);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 140ms ease-out;
  }
  .nav.is-open .nav__scrim {
    opacity: 1;
    pointer-events: auto;
    transition-duration: 200ms;
  }

  .nav__sheet {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: var(--inset);
    right: var(--inset);
    flex-direction: column;
    max-height: calc(100dvh - var(--bar-h) - var(--safe-t) - var(--safe-b) - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: var(--radius-bar);
    background: #0c0c0d;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.09),
      0 24px 48px -16px rgba(0, 0, 0, 0.9);
    /* Grows out of the menu button's corner. */
    transform-origin: calc(100% - 1.75rem) -0.5rem;
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
    visibility: hidden;
    /* Closing: quicker than opening, then out of the tab order. */
    transition:
      opacity 140ms ease-out,
      transform 140ms var(--ease-out),
      visibility 0s linear 140ms;
  }
  .nav.is-open .nav__sheet {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity 200ms ease-out,
      transform 200ms var(--ease-out),
      visibility 0s;
  }
  /* Focused after a tap, so a link doesn't open looking selected. */
  .nav__sheet:focus {
    outline: none;
  }
  /* Keyboard open and Escape skip the motion. */
  .nav.is-instant .nav__sheet,
  .nav.is-instant .nav__scrim,
  .nav.is-instant .nav__bar::before,
  .nav.is-instant .nav__burger i {
    transition: none;
  }
  .nav__group {
    display: flex;
    flex-direction: column;
    padding: 0.375rem;
  }
  .nav__group + .nav__group {
    border-top: 1px solid var(--line);
  }
  .nav__group--pad {
    padding: 0.875rem 0.875rem 1rem;
  }
  .nav__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    padding: 0 0.75rem;
    border-radius: 10px;
    font-size: 1.0625rem;
    color: var(--text-2);
    transition: background-color 120ms ease;
  }
  .nav__row:focus-visible,
  .nav__install:focus-visible {
    outline-offset: -2px;
    border-radius: 10px;
  }
  .nav__row:active {
    background: rgba(255, 255, 255, 0.06);
  }
  .nav__row[aria-current="page"] {
    color: var(--text);
  }
  .nav__row[aria-current="page"]::after {
    content: "";
    width: 5px;
    height: 5px;
    background: var(--text);
  }
  .nav__row-main {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .nav__ext {
    color: var(--text-muted);
  }
  .nav__cap {
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .nav__install {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.6rem 0.55rem 0.7rem;
    border-radius: 10px;
    font-family: var(--font-mono);
    /* 12px, a touch tight: the whole one-liner fits a 390px phone. Narrower,
       it breaks once, before "| sh". */
    font-size: 0.75rem;
    letter-spacing: -0.02em;
    line-height: 1.45;
    text-align: left;
    color: var(--text);
    background: #141416;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    cursor: copy;
    transition: transform 140ms var(--ease-out);
  }
  .nav__install code {
    min-width: 0;
    font: inherit;
  }
  .nav__install code span {
    white-space: nowrap;
  }
  .nav__install:active {
    transform: scale(0.985);
  }
  .nav__install :global(.copyico) {
    color: var(--text-muted);
  }
  .nav__install:global(.is-copied) :global(.copyico) {
    color: var(--pass);
  }
  @media (max-width: 879px) {
    .nav__bar {
      grid-template-columns: minmax(0, 1fr) auto;
      /* Brand 1rem inside the pill; the 40px button 0.5rem inside it, so the
         button's 8px gap matches the gap above and below it. */
      padding-inline: calc(var(--inset) + 1rem) calc(var(--inset) + 0.5rem);
    }
    .nav__links,
    .nav__src {
      display: none;
    }
    :global(html.js) .nav__menu-btn {
      display: grid;
    }
    :global(html.js) .nav__sheet,
    :global(html.js) .nav__scrim {
      display: flex;
    }
    /* No JS, no sheet: the links stay in the bar. */
    :global(html:not(.js)) .nav__links {
      display: flex;
    }
    :global(html:not(.js)) .nav__link {
      padding-inline: 0.5rem;
    }
  }
  @media (max-width: 879px) and (prefers-reduced-motion: reduce) {
    .nav__sheet,
    .nav.is-open .nav__sheet {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__src:active,
    .nav__menu-btn:active,
    .nav__install:active {
      transform: none;
    }
    .nav__bar,
    .nav__bar::before,
    .nav__link,
    .nav__src,
    .nav__burger i {
      transition: none;
    }
  }
</style>

<script>
  import { copyText, flashCopied } from "../lib/copy";

  function setupNav() {
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    if (!nav || nav.dataset.bound) return;
    nav.dataset.bound = "1";
    const root = document.documentElement;
    let ticking = false;
    const update = () => {
      nav.classList.toggle("is-scrolled", scrollY > 8);
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const btn = nav.querySelector<HTMLButtonElement>("[data-nav-btn]")!;
    const sheet = nav.querySelector<HTMLElement>("[data-nav-sheet]")!;
    const scrim = nav.querySelector<HTMLElement>("[data-nav-scrim]")!;
    // Rendered hidden for no-JS; from here on visibility and the transition own it.
    sheet.hidden = false;
    const focusables = () => [btn, ...sheet.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")];
    const isOpen = () => nav.classList.contains("is-open");
    // Everything outside the nav (the page, the footer, the skip link): inert
    // while the sheet is open, so a screen reader's swipe can't leave it either.
    const outside = () => {
      const out: HTMLElement[] = [];
      for (let el: HTMLElement | null = nav; el && el.parentElement && el !== document.body; el = el.parentElement)
        for (const sib of el.parentElement.children) if (sib !== el && sib instanceof HTMLElement && !(sib instanceof HTMLScriptElement)) out.push(sib);
      return out;
    };

    // `fromKeys`: opened with Enter/Space or closed with Escape. That path has
    // no motion, and the first link takes focus; after a tap the sheet itself
    // does, so no link shows a focus ring.
    const setOpen = (open: boolean, focusBack = true, fromKeys = false) => {
      if (open === isOpen()) return;
      if (fromKeys) {
        nav.classList.add("is-instant");
        requestAnimationFrame(() => requestAnimationFrame(() => nav.classList.remove("is-instant")));
      }
      nav.classList.toggle("is-open", open);
      for (const el of outside()) el.inert = open;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Menu");
      if (open) {
        // Keep the page still. html reserves the scrollbar's gutter
        // (scrollbar-gutter: stable), so hiding the overflow moves nothing.
        root.style.overflow = "hidden";
        (fromKeys ? sheet.querySelector<HTMLElement>("a[href]") : sheet)?.focus({ preventScroll: true });
      } else {
        root.style.overflow = "";
        if (focusBack) btn.focus({ preventScroll: true });
      }
    };

    // A click from Enter or Space has detail 0; a tap or mouse click has 1+.
    btn.addEventListener("click", (e) => setOpen(!isOpen(), true, e.detail === 0));
    scrim.addEventListener("click", () => setOpen(false));
    // overflow:hidden on <html> is not enough on iOS: swallow drags on the scrim too.
    const still = (e: Event) => e.preventDefault();
    scrim.addEventListener("touchmove", still, { passive: false });
    scrim.addEventListener("wheel", still, { passive: false });
    // A link closes the sheet; the page change (or anchor) follows.
    sheet.querySelectorAll<HTMLAnchorElement>("a.nav__row").forEach((a) => a.addEventListener("click", () => setOpen(false, false)));

    const onKey = (e: KeyboardEvent) => {
      if (!isOpen()) return;
      if (e.key === "Escape") {
        e.preventDefault();
        setOpen(false, true, true);
      } else if (e.key === "Tab") {
        const f = focusables();
        // Focus on the sheet itself (after a tap) counts as the button, so Tab
        // goes to the first link and Shift+Tab to the last control.
        const at = Math.max(0, f.indexOf(document.activeElement as HTMLElement));
        const next = e.shiftKey ? (at === 0 ? f.length - 1 : at - 1) : at === f.length - 1 ? 0 : at + 1;
        e.preventDefault();
        f[next]?.focus();
      }
    };
    // Widening past the breakpoint hides the button; don't leave the page locked.
    const wide = matchMedia("(min-width: 880px)");
    const onWide = () => wide.matches && setOpen(false, false);

    addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener("keydown", onKey);
    wide.addEventListener("change", onWide);
    update();
    document.addEventListener(
      "astro:before-swap",
      () => {
        setOpen(false, false);
        removeEventListener("scroll", onScroll);
        document.removeEventListener("keydown", onKey);
        wide.removeEventListener("change", onWide);
      },
      { once: true },
    );
  }
  document.addEventListener("astro:page-load", setupNav);

  // Every copy button on the site ([data-copy]: the hero, the closing CTA and
  // the sheet's install row), wired once on the document so it survives page
  // swaps without rebinding. Enhancement only: without JS the command is still
  // plain, selectable text. The sheet announces in its own live region (the
  // page's is inert while the sheet is open), everything else in the page's.
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLElement>("[data-copy]");
    if (!btn || !(await copyText(btn.dataset.copy ?? ""))) return;
    flashCopied(btn);
    const status =
      btn.closest("[data-nav-sheet]")?.querySelector<HTMLElement>("[data-nav-copy-status]") ??
      document.querySelector<HTMLElement>("[data-copy-status]");
    if (status) {
      status.textContent = "Copied to clipboard";
      setTimeout(() => (status.textContent = ""), 1600);
    }
  });
</script>
