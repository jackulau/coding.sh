---
// Copy glyph that turns into a check while its [data-copy] button is in the
// copied state (.is-copied). Decorative: the button carries the label.
---

<span class="copyico" aria-hidden="true">
  <svg class="copyico__copy" width="16" height="16" viewBox="0 0 16 16" focusable="false">
    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
    <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" fill="none" stroke="currentColor" stroke-width="1.3"></path>
  </svg>
  <svg class="copyico__ok" width="16" height="16" viewBox="0 0 16 16" focusable="false">
    <path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</span>

<style>
  .copyico {
    position: relative;
    display: inline-grid;
    flex: none;
    width: 16px;
    height: 16px;
  }
  .copyico svg {
    grid-area: 1 / 1;
    transition:
      opacity 150ms ease,
      transform 150ms var(--ease-out);
  }
  .copyico__ok {
    opacity: 0;
    transform: scale(0.6);
  }
  :global(.is-copied) .copyico__copy {
    opacity: 0;
    transform: scale(0.6);
  }
  :global(.is-copied) .copyico__ok {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .copyico svg {
      transition: none;
    }
  }
</style>
