---
// The one surface for anything the machine produces. A title bar with the
// working context on the left, then a fixed-width body that scrolls inside
// its own box rather than widening the page. When it does overflow, the right
// edge fades until the reader has scrolled to the end, so clipped output
// always looks clipped.
interface Props {
  /** Left of the title bar: cwd, file name, or command context. */
  title?: string;
  class?: string;
  bodyClass?: string;
  /** Accessible name for the region. */
  label?: string;
}
const { title, class: klass, bodyClass, label } = Astro.props;
---

<figure class:list={["term", klass]} aria-label={label}>
  <figcaption class="term__bar">
    <span class="term__title">{title}<slot name="title" /></span>
    <span class="term__meta">
      <slot name="meta" />
    </span>
  </figcaption>
  <div class:list={["term__body", bodyClass]} data-term-body>
    <slot />
  </div>
  <slot name="footer" />
</figure>

<style>
  .term {
    margin: 0;
    min-width: 0;
    background: var(--term);
    border-radius: var(--radius);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      0 1px 0 0 rgba(255, 255, 255, 0.02);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--text-2);
  }
  .term__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 2.5rem;
    padding: 0 0.75rem 0 1rem;
    background: var(--term-bar);
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .term__title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .term__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex: none;
  }
  .term__body {
    padding: 0.9rem 1rem 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  .term__body[data-overflow]:not([data-end]) {
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
  }
  .term__body:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: -2px;
  }
  .term__body :global(pre) {
    margin: 0;
    font: inherit;
    white-space: pre;
  }
  /* Phones: 12px mono fits 45 columns in a 390px screen. */
  @media (max-width: 479px) {
    .term {
      font-size: var(--fs-xs);
    }
  }
  @media (min-width: 640px) {
    .term__body {
      padding: 1rem 1.25rem 1.15rem;
    }
  }
</style>

<script>
  // A body wider than its box scrolls sideways; only then is it a tab stop, so
  // keyboard users can scroll it with the arrow keys (WCAG 2.1.1).
  const atEnd = (body: HTMLElement) => body.toggleAttribute("data-end", body.scrollLeft + body.clientWidth >= body.scrollWidth - 1);
  function mark() {
    for (const body of document.querySelectorAll<HTMLElement>("[data-term-body]")) {
      const over = body.scrollWidth > body.clientWidth + 1;
      body.toggleAttribute("data-overflow", over);
      if (over) body.tabIndex = 0;
      else body.removeAttribute("tabindex");
      if (!body.dataset.bound) {
        body.dataset.bound = "1";
        body.addEventListener("scroll", () => atEnd(body), { passive: true });
      }
      atEnd(body);
    }
  }
  let queued = 0;
  addEventListener("resize", () => {
    cancelAnimationFrame(queued);
    queued = requestAnimationFrame(mark);
  });
  document.addEventListener("astro:page-load", mark);
</script>
