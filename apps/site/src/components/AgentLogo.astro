---
// One agent: its logo (or a neutral glyph) and its name, in currentColor.
// The name is real text, so the mark itself is decorative.
import { logo } from "../lib/logos";

interface Props {
  id: string;
  name: string;
  /** Logo height in px. */
  size?: number;
  /** Draw a neutral terminal glyph when the agent has no published logo. */
  fallback?: boolean;
  class?: string;
}
const { id, name, size = 20, fallback = false, class: cls } = Astro.props;
const l = logo(id);
// No published mark: a neutral terminal prompt, so every agent has a
// glyph row. It is generic on purpose; it is not anyone's logo.
const FALLBACK = { viewBox: "0 0 24 24", body: '<path d="M4.5 7.5 9 12l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/><path d="M12 17.25h7.5" fill="none" stroke="currentColor" stroke-width="1.8"/>', evenodd: false };
const mark = l ?? (fallback ? FALLBACK : undefined);
---

<span class:list={["alogo", cls]}>
  {
    mark && (
      <svg
        class="alogo__mark"
        width={size}
        height={size}
        viewBox={mark.viewBox}
        fill="currentColor"
        fill-rule={mark.evenodd ? "evenodd" : undefined}
        aria-hidden="true"
        focusable="false"
        set:html={mark.body}
      />
    )
  }
  <span class="alogo__name">{name}</span>
</span>

<style>
  .alogo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  .alogo__mark {
    flex: none;
  }
</style>
