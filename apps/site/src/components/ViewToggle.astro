---
// HUMAN | AGENT on every page that has a Markdown twin. On pages with the site
// nav it is docked in the nav bar, over the slot Nav.astro reserves for it, so
// it never covers content; elsewhere it floats at the bottom centre. It stays
// outside the nav because the agent view hides the nav.
// AGENT replaces the whole page (nav included) with that page's Markdown,
// syntax-tinted, plus a "Copy page" menu. Without JS the AGENT segment is a
// plain link to the .md file. The choice persists (localStorage) and
// ?view=agent selects it; html.view-agent is set in <head> before first paint.
interface Props {
  /** This page's Markdown twin, e.g. /index.md. */
  md: string;
}
const { md } = Astro.props;
const mdAbs = new URL(md, Astro.site).toString();
const ask = encodeURIComponent(`Read ${mdAbs} and help me set up coding.sh`);
---

<div class="agentdoc" id="agent-view" role="tabpanel" aria-labelledby="view-tab-agent" data-agentdoc data-md={md}>
  <div class="agentdoc__inner">
    <div class="agentdoc__bar">
      <div class="cp" data-cp>
        <button type="button" class="cp__main" data-cp-copy>
          <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
            <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" fill="none" stroke="currentColor" stroke-width="1.3"></path>
          </svg>
          <span data-copy-label>Copy page</span>
        </button>
        <button type="button" class="cp__more" aria-label="More page options" aria-haspopup="menu" aria-expanded="false" data-cp-toggle>
          <svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
            <path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="cp__menu" role="menu" hidden data-cp-menu>
          <button type="button" role="menuitem" data-cp-copy>Copy as Markdown</button>
          <a role="menuitem" href={md}>View as .md</a>
          <a role="menuitem" href={`https://claude.ai/new?q=${ask}`} target="_blank" rel="noopener">Open in Claude</a>
          <a role="menuitem" href={`https://chatgpt.com/?q=${ask}`} target="_blank" rel="noopener">Open in ChatGPT</a>
        </div>
      </div>
    </div>
    <pre class="agentdoc__md" data-agentdoc-body tabindex="0" aria-label="This page as Markdown"></pre>
  </div>
</div>

<div class="viewtog" role="tablist" aria-label="Show this page for" data-viewtog>
  <a href="?view=human" class="viewtog__tab" role="tab" id="view-tab-human" aria-controls="human-view" data-view="human">Human</a>
  <a href={md} class="viewtog__tab" role="tab" id="view-tab-agent" aria-controls="agent-view" data-view="agent">Agent</a>
</div>

<style>
  /* ---- which view ---- */
  .agentdoc {
    display: none;
  }
  :global(html.view-agent) .agentdoc {
    display: block;
  }
  /* The skip link targets #main, which the agent view hides. */
  :global(html.view-agent #human-view),
  :global(html.view-agent .skip-link) {
    display: none !important;
  }
  /* The swap itself is instant: only the thumb moves, so the switch can be
     flicked back and forth without a page fade to wait on. */

  /* ---- the toggle ---- */
  .viewtog {
    position: fixed;
    left: 50%;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    border-radius: 999px;
    background: rgba(12, 12, 13, 0.88);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 12px 32px -10px rgba(0, 0, 0, 0.9);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    translate: -50% 0;
  }
  /* Docked in the nav bar (Nav.astro .nav__tog-slot): same box, same place.
     The bar is max 76rem wide with 2rem padding; on narrow screens the
     slot sits left of the 2.75rem menu button. */
  :global(html:has([data-nav])) .viewtog {
    top: calc((3.5rem - 38px) / 2);
    bottom: auto;
    left: auto;
    right: calc(max(0px, (100% - 76rem) / 2) + 2rem);
    translate: none;
    background: #0d0d0f;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.11);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    transition: transform 180ms var(--ease-out);
  }
  /* Follow the nav when it lifts into its floating pill. */
  :global(html:has(.nav.is-scrolled)) .viewtog {
    transform: translateY(0.5rem);
  }
  @media (max-width: 879px) {
    :global(html:has([data-nav])) .viewtog {
      right: 4.5rem;
    }
  }
  @media (max-width: 399px) {
    :global(html:has([data-nav])) .viewtog {
      right: 4rem;
    }
  }
  /* The white thumb slides between the two segments. */
  .viewtog::before {
    content: "";
    position: absolute;
    inset: 3px auto 3px 3px;
    width: calc(50% - 3px);
    border-radius: 999px;
    background: #f4f4f5;
    transition: transform 180ms var(--ease-out);
  }
  :global(html.view-agent) .viewtog::before {
    transform: translateX(100%);
  }
  .viewtog[data-input="key"]::before {
    transition: none;
  }
  .viewtog__tab {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 4.75rem;
    min-height: 32px;
    padding: 0 0.75rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
    transition: color 180ms ease;
  }
  @media (max-width: 879px) {
    .viewtog__tab {
      min-width: 4.25rem;
      padding: 0 0.5rem;
    }
  }
  @media (max-width: 399px) {
    .viewtog__tab {
      min-width: 3.5rem;
      padding: 0 0.3rem;
      font-size: 10px;
      letter-spacing: 0.06em;
    }
  }
  /* A bigger hit area than the visual pill on touch screens. */
  @media (pointer: coarse) {
    .viewtog__tab::after {
      content: "";
      position: absolute;
      inset: -4px 0;
    }
  }
  .viewtog__tab[data-view="human"],
  :global(html.view-agent) .viewtog__tab[data-view="agent"] {
    color: #000;
  }
  :global(html.view-agent) .viewtog__tab[data-view="human"] {
    color: var(--text-2);
  }
  .viewtog__tab:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html:not(.view-agent)) .viewtog__tab[data-view="agent"]:hover,
    :global(html.view-agent) .viewtog__tab[data-view="human"]:hover {
      color: var(--text);
    }
  }

  /* ---- the Markdown page ---- */
  .agentdoc {
    min-height: 100dvh;
    background: var(--term);
  }
  .agentdoc__inner {
    max-width: 68.75rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 8rem;
  }
  @media (min-width: 768px) {
    .agentdoc__inner {
      padding: 3.5rem 2.5rem 9rem;
    }
  }
  /* The docked switch sits where the nav was; keep the page clear of it. */
  :global(html:has([data-nav])) .agentdoc__inner {
    padding-top: 4.5rem;
    padding-bottom: 4rem;
  }
  .agentdoc__bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }
  .agentdoc__md {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.75;
    color: #c4c4c9;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .agentdoc__md:focus-visible {
    outline: none;
  }
  .agentdoc__md :global(.md-mk) {
    color: var(--text-muted);
  }
  .agentdoc__md :global(.md-key) {
    color: var(--text-muted);
  }
  .agentdoc__md :global(.md-val) {
    color: #a8a8ae;
  }
  .agentdoc__md :global(.md-h) {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 700;
    color: #fff;
  }
  .agentdoc__md :global(.md-h1) {
    font-size: 1.75rem;
    line-height: 1.3;
  }
  .agentdoc__md :global(.md-h2) {
    font-size: 1.25rem;
  }
  .agentdoc__md :global(.md-h .md-mk) {
    font-size: 0.875rem;
    font-weight: 400;
  }
  .agentdoc__md :global(.md-quote) {
    color: #a8a8ae;
  }
  .agentdoc__md :global(.md-link),
  .agentdoc__md :global(strong) {
    font-weight: 700;
    color: #fff;
  }
  .agentdoc__md :global(.md-url) {
    color: var(--text-muted);
  }
  .agentdoc__md :global(.md-code) {
    color: #e4e4e7;
  }
  .agentdoc__md :global(.md-pre) {
    color: #e4e4e7;
  }
  @media (max-width: 639px) {
    .agentdoc__md {
      font-size: 0.8125rem;
      line-height: 1.7;
    }
    .agentdoc__md :global(.md-h1) {
      font-size: 1.375rem;
    }
  }

  /* ---- Copy page ---- */
  .cp {
    position: relative;
    display: inline-flex;
    border-radius: 11px;
    background: #141416;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.11);
  }
  .cp__main,
  .cp__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 0.85rem;
    font-size: var(--fs-sm);
    color: var(--text);
    transition: background-color var(--hover-out) ease;
  }
  .cp__main {
    border-radius: 11px 0 0 11px;
  }
  .cp__more {
    padding: 0 0.7rem;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0 11px 11px 0;
  }
  .cp__main:global(.is-copied) {
    color: var(--pass);
  }
  @media (hover: hover) and (pointer: fine) {
    .cp__main:hover,
    .cp__more:hover {
      background: #1c1c1f;
    }
  }
  .cp__menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    min-width: 13rem;
    padding: 0.35rem;
    border-radius: 13px;
    background: rgba(16, 16, 18, 0.98);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 16px 40px -12px rgba(0, 0, 0, 0.9);
    transform-origin: top right;
  }
  .cp__menu[hidden] {
    display: none;
  }
  .cp__menu > * {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.8rem;
    border-radius: 9px;
    font-size: var(--fs-sm);
    text-align: left;
    color: var(--text-2);
  }
  .cp__menu > *:hover,
  .cp__menu > *:focus-visible {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
    outline: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cp__menu:not([hidden]) {
      animation: menu-in 150ms var(--ease-out);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(-3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .viewtog,
    .viewtog::before,
    .viewtog__tab {
      transition: none !important;
    }
  }
</style>

<script>
  import { copyText, flashCopied } from "../lib/copy";

  const KEY = "coding.sh:view";
  const root = document.documentElement;
  let mdCache: { url: string; text: string } | undefined;

  async function fill() {
    const doc = document.querySelector<HTMLElement>("[data-agentdoc]");
    const body = doc?.querySelector<HTMLElement>("[data-agentdoc-body]");
    const url = doc?.dataset.md;
    if (!doc || !body || !url || body.dataset.filled === url) return;
    try {
      const [res, { highlight }] = await Promise.all([fetch(url), import("../lib/md-highlight")]);
      if (!res.ok) throw new Error(String(res.status));
      const text = await res.text();
      mdCache = { url, text };
      body.innerHTML = highlight(text);
      body.dataset.filled = url;
    } catch {
      body.innerHTML = `This page's Markdown is at <a class="md-link" href="${url}">${url}</a>.`;
    }
  }

  function apply(view: string) {
    const agent = view === "agent";
    root.classList.toggle("view-agent", agent);
    document.querySelectorAll<HTMLAnchorElement>("[data-viewtog] [role=tab]").forEach((t) => {
      const on = t.dataset.view === view;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
    });
    if (agent) void fill();
  }

  // Where the reader was in the human view, so coming back lands there.
  let humanScroll = 0;

  function choose(view: string) {
    const current = root.classList.contains("view-agent") ? "agent" : "human";
    if (view === current) return; // reselecting the active view does nothing
    try {
      localStorage.setItem(KEY, view);
    } catch {}
    const url = new URL(location.href);
    if (view === "agent") url.searchParams.set("view", "agent");
    else url.searchParams.delete("view");
    history.replaceState(history.state, "", url);
    if (view === "agent") humanScroll = scrollY;
    apply(view);
    scrollTo({ top: view === "agent" ? 0 : humanScroll, behavior: "instant" });
  }

  function setup() {
    const tog = document.querySelector<HTMLElement>("[data-viewtog]");
    if (!tog || tog.dataset.bound) return;
    tog.dataset.bound = "1";
    apply(root.classList.contains("view-agent") ? "agent" : "human");

    const tabs = [...tog.querySelectorAll<HTMLAnchorElement>("[role=tab]")];
    tabs.forEach((t, i) => {
      t.addEventListener("click", (e) => {
        e.preventDefault();
        // Pointer clicks slide the thumb; keyboard (detail 0) moves it at once.
        tog.dataset.input = e.detail > 0 ? "pointer" : "key";
        choose(t.dataset.view!);
      });
      t.addEventListener("keydown", (e) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(e.key)) return;
        e.preventDefault();
        const next = e.key === "Home" ? 0 : e.key === "End" ? tabs.length - 1 : (i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
        tabs[next].focus();
        tog.dataset.input = "key";
        choose(tabs[next].dataset.view!);
      });
    });

    // Copy page and its menu.
    const cp = document.querySelector<HTMLElement>("[data-cp]");
    const menu = cp?.querySelector<HTMLElement>("[data-cp-menu]");
    const toggle = cp?.querySelector<HTMLButtonElement>("[data-cp-toggle]");
    const main = cp?.querySelector<HTMLButtonElement>(".cp__main");
    const setOpen = (open: boolean) => {
      if (!menu || !toggle) return;
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      if (open) menu.querySelector<HTMLElement>("[role=menuitem]")?.focus();
    };
    toggle?.addEventListener("click", () => setOpen(!!menu?.hidden));
    cp?.querySelectorAll<HTMLButtonElement>("[data-cp-copy]").forEach((b) =>
      b.addEventListener("click", async () => {
        await fill();
        if (mdCache && (await copyText(mdCache.text)) && main) flashCopied(main, "Copied", "Copy page");
        setOpen(false);
      }),
    );
    const onDoc = (e: Event) => {
      if (menu && !menu.hidden && !cp!.contains(e.target as Node)) setOpen(false);
    };
    const onKey = (e: KeyboardEvent) => {
      if (!menu || menu.hidden) return;
      const items = [...menu.querySelectorAll<HTMLElement>("[role=menuitem]")];
      const at = items.indexOf(document.activeElement as HTMLElement);
      if (e.key === "Escape") {
        setOpen(false);
        toggle?.focus();
      } else if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        items[(at + (e.key === "ArrowDown" ? 1 : -1) + items.length) % items.length]?.focus();
      }
    };
    document.addEventListener("click", onDoc);
    document.addEventListener("keydown", onKey);
    document.addEventListener(
      "astro:before-swap",
      () => {
        document.removeEventListener("click", onDoc);
        document.removeEventListener("keydown", onKey);
      },
      { once: true },
    );
  }

  // View transitions replace <html> attributes; carry the choice across.
  document.addEventListener("astro:after-swap", () => {
    let v: string | null = null;
    try {
      v = localStorage.getItem(KEY);
    } catch {}
    root.classList.toggle("view-agent", v === "agent" && !!document.querySelector("[data-agentdoc]"));
  });
  document.addEventListener("astro:page-load", setup);
</script>
