---
// Docs shell: the site Layout and Nav, a sidebar on wide screens, a disclosure
// menu on narrow ones (works without JS), the page, then prev/next. Title and
// description come from nav.ts so the sidebar, <title> and llms.txt agree.
// A page that sits under a nav.ts entry without its own sidebar row (one CLI
// command, /docs/cli/<name>) passes `page` and `parent`, and its own prev/next:
// the sidebar and the breadcrumbs then point at the parent. A nav.ts sub page
// (`children`) gets the same from nav.ts. At 1280px and wider an "On this
// page" rail lists the page's h2s, and a Tabs block as its tab labels.
import { existsSync } from "node:fs";
import { join } from "node:path";
import Layout from "../../layouts/Layout.astro";
import Nav from "../Nav.astro";
import Search from "./Search.astro";
import { SITE } from "../../data/site";
import { DOC_GROUPS, docPage, groupOf, neighbours, parentOf, type DocPage } from "./nav";
import { techArticleSchema, faqSchema } from "../../lib/schema";
import { pageLastmod } from "../../lib/lastmod.mjs";
import { isAgentExcluded } from "../../lib/agent-routes.mjs";
import "../../styles/doc.css";

interface Props {
  /** Extra JSON-LD for this page (the FAQ page passes its questions). */
  schemas?: Record<string, unknown>[];
  page?: DocPage;
  parent?: DocPage;
  prev?: DocPage;
  next?: DocPage;
}
const { schemas = [] } = Astro.props;

const path = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, "") : Astro.url.pathname;
const page = Astro.props.page ?? docPage(path);
const parent = Astro.props.parent ?? parentOf(page.path);
const current = parent ?? page;
const currentGroup = groupOf(current.path);
const { prev, next } = Astro.props.page ? Astro.props : neighbours(path);
const isIndex = page.path === "/docs";
// The page as Markdown (scripts/gen-agent-text.mjs writes <path>.md), for "Copy page" and "View as Markdown".
const markdownURL = isAgentExcluded(path) ? null : `${path}.md`;
// Search ranks task pages (guides, how-tos) above reference pages: a reader who types
// "trace my python agent" wants the guide first, the full API second. Weights are
// Pagefind's (default 1, h1 7): a guide's title and lede count more, a reference
// page's body counts less.
const isReference = currentGroup?.label === "Reference" || current.path.startsWith("/docs/cli");
const title = page.metaTitle ?? (isIndex ? `${SITE.name} docs: observability and evals for any AI agent` : `${page.title} · ${SITE.name} docs`);
const breadcrumbs = isIndex
  ? [{ name: "Docs", path: "/docs" }]
  : [
      { name: "Docs", path: "/docs" },
      ...(parent ? [{ name: parent.label, path: parent.path }] : []),
      { name: page.label, path: page.path },
    ];
// Title card from scripts/gen-og.mjs (npm run og).
const card = (p: DocPage) => `/og/${p.path === "/docs" ? "docs" : `docs-${p.path.slice("/docs/".length).replace(/\//g, "-")}`}.png`;
// A page without a card yet uses its parent's, or the site card.
const ogImage = [card(page), ...(parent ? [card(parent)] : [])].find((c) => existsSync(join(process.cwd(), "public", c))) ?? "/og-image.png";
const article = techArticleSchema({ ...page, image: ogImage, dateModified: pageLastmod(page.path) });

// Headings link to themselves (#id), rendered into the HTML, so no script needed.
const body = (await Astro.slots.render("default")).replace(
  /<(h[23]) id="([^"]+)"([^>]*)>([\s\S]*?)<\/\1>/g,
  (_, tag, id, rest, inner) => `<${tag} id="${id}"${rest}><a class="h-anchor" href="#${id}">${inner}</a></${tag}>`,
);

// A "## Questions" section whose ### headings are questions is shown on the
// page as Q&A, so it is also marked up as FAQPage, word for word.
const questions = body.match(/<h2 id="questions"[^>]*>[\s\S]*?(?=<h2[ >]|$)/)?.[0] ?? "";
const faq = [...questions.matchAll(/<h3 [^>]*>([\s\S]*?)<\/h3>([\s\S]*?)(?=<h3[ >]|$)/g)]
  .map((m) => ({ q: m[1]!, a: m[2]! }))
  .filter((f) => f.q.trim().endsWith("?</a>") || f.q.trim().endsWith("?"));
const faqSchemas = faq.length ? [faqSchema(faq)] : [];

// "On this page": the h2s outside tab panels, in order, and each Tabs block
// as its tab labels, each followed by its panel's h3 steps (Tabs.astro writes
// them to data-toc). A step shows only while its tab is open.
// Astro writes `"` in an attribute as &#34; and the Markdown renderer as &quot;: decode both.
const NAMED: Record<string, string> = { quot: '"', apos: "'", lt: "<", gt: ">", amp: "&" };
const unesc = (s: string) =>
  s.replace(/&(?:#(\d+)|#x([0-9a-f]+)|(quot|apos|lt|gt|amp));/gi, (m, d?: string, h?: string, n?: string) =>
    d ? String.fromCodePoint(Number(d)) : h ? String.fromCodePoint(parseInt(h, 16)) : (NAMED[n!.toLowerCase()] ?? m),
  );
const plain = (s: string) => unesc(s.replace(/<[^>]+>/g, "")).replace(/\s+/g, " ").trim();
const outline: { id: string; label: string; tab?: boolean; inTab?: string; closed?: boolean }[] = [];
for (const m of body.matchAll(/<h2 id="([^"]+)"([^>]*)>([\s\S]*?)<\/h2>|<div class="tabs" data-tabs="[^"]*" data-toc="([^"]*)"/g)) {
  if (m[4] !== undefined) {
    const tabs = JSON.parse(unesc(m[4])) as { id: string; label: string; steps?: { id: string; label: string }[] }[];
    for (const t of tabs) {
      outline.push({ id: t.id, label: t.label, tab: true });
      // The first tab opens by default, so the others' steps start hidden.
      for (const st of t.steps ?? []) outline.push({ id: st.id, label: plain(st.label), inTab: t.id, closed: t !== tabs[0] });
    }
  } else if (!/\bdata-in-tabs\b/.test(m[2]!)) outline.push({ id: m[1]!, label: plain(m[3]!) });
}
const showOutline = outline.length >= 2;
---

<Layout title={title} description={page.summary} breadcrumbs={breadcrumbs} image={ogImage} schemas={[article, ...faqSchemas, ...schemas]}>
  <Nav />
  <div class="wrap docs">
    <aside class="docs__side" aria-label="Docs">
      <div class="docs__rail">
      <Search id="side" />
      <nav class="docs__toc">
        {
          DOC_GROUPS.map((g) => (
            <div class="docs__group">
              <p class="docs__group-label">{g.label}</p>
              <ul>
                {g.pages.map((p) => (
                  <li>
                    <a href={p.path} class="docs__link" aria-current={p.path === current.path ? "page" : undefined}>
                      {p.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
      </div>
    </aside>

    <div class="docs__body">
      <details class="docs__menu" data-docs-menu>
        <summary class="docs__menu-sum">
          <span class="docs__menu-kicker">Docs</span>
          <span class="docs__menu-current">{current.label}</span>
          <svg class="docs__menu-chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
            <path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <Search id="menu" class="docs__menu-search search--fill" />
        <nav class="docs__menu-list" aria-label="Docs">
          {
            DOC_GROUPS.map((g) => (
              <details class="docs__fold" open={g === currentGroup}>
                <summary class="docs__fold-sum">
                  {g.label}
                  <svg class="docs__fold-chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                    <path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <ul>
                  {g.pages.map((p) => (
                    <li>
                      <a href={p.path} class="docs__link" aria-current={p.path === current.path ? "page" : undefined}>
                        {p.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
        </nav>
      </details>
      {/* Keep the current page in view: in the sidebar in the first frame, in
          the menu when it opens. A click on a visible link leaves the sidebar
          where it was. Runs again after each page swap (data-astro-rerun).
          The first centring waits for the frame, so it reads the layout the
          frame does anyway and adds none while the page is still parsing.
          Under 1024px the sidebar is hidden, so it waits until the window is
          wide enough to show it. */}
      <script is:inline data-astro-rerun>
        {
          const c = (l) => {
            const a = l && l.querySelector("[aria-current=page]");
            if (!a) return;
            const d = a.getBoundingClientRect().top - l.getBoundingClientRect().top;
            if (d < 0 || d + a.offsetHeight > l.clientHeight - 24) l.scrollTop += d - (l.clientHeight - a.offsetHeight) / 2;
          };
          const t = document.querySelector(".docs__toc");
          const m = document.querySelector("[data-docs-menu]");
          const wide = matchMedia("(min-width: 1024px)");
          const side = () => c(document.querySelector(".docs__toc"));
          if (wide.matches) requestAnimationFrame(side);
          else wide.addEventListener("change", side, { once: true });
          m && m.addEventListener("toggle", () => m.open && c(m.querySelector(".docs__menu-list")));
          document.addEventListener("astro:before-swap", () => {
            const s = t && t.scrollTop;
            document.addEventListener("astro:after-swap", () => {
              const n = document.querySelector(".docs__toc");
              if (n) (n.scrollTop = s), c(n);
            }, { once: true });
          }, { once: true });
        }
      </script>

      <main id="main" class="doc" data-pagefind-body>
        {page.searchTerms && <span hidden data-pagefind-meta="keywords[data-terms]" data-terms={page.searchTerms.join(", ")} />}
        {
          markdownURL && (
            <div class="doc__tools" data-agent-skip data-pagefind-ignore>
              <button type="button" class="doc__tool" data-copy-page={markdownURL}>Copy page</button>
              <a class="doc__tool" href={markdownURL}>View as Markdown</a>
            </div>
          )
        }
        <h1 data-pagefind-weight={isReference ? "5" : "10"}>{page.title}</h1>
        <p class="lede doc__lede" data-pagefind-weight={isReference ? "1" : "5"}>{page.summary}</p>
        {isReference ? <div data-pagefind-weight="0.5" style="display: contents"><Fragment set:html={body} /></div> : <Fragment set:html={body} />}

        {
          (prev || next) && (
            <nav class="pager" aria-label="Previous and next page" data-agent-skip data-pagefind-ignore>
              {prev ? (
                <a href={prev.path} class="pager__link" rel="prev">
                  <span class="pager__dir">Previous</span>
                  <span class="pager__title">{prev.label}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a href={next.path} class="pager__link pager__link--next" rel="next">
                  <span class="pager__dir">Next</span>
                  <span class="pager__title">{next.label}</span>
                </a>
              )}
            </nav>
          )
        }
      </main>

      {
        showOutline && (
          <aside class="onpage" aria-label="On this page" data-onpage data-agent-skip data-pagefind-ignore>
            <p class="onpage__title">On this page</p>
            <ul>
              {outline.map((o) => (
                <li data-in-tab={o.inTab} hidden={o.closed}>
                  <a href={`#${o.id}`} class:list={["onpage__link", { "onpage__link--tab": o.tab, "onpage__link--step": o.inTab }]}>
                    {o.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </div>
</Layout>

<script>
  // "Copy page": the page's Markdown twin to the clipboard. The fetch goes inside the
  // ClipboardItem so Safari still counts the click as the gesture.
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>("[data-copy-page]");
    if (!btn) return;
    const url = btn.dataset.copyPage!;
    const text = () => fetch(url).then((r) => (r.ok ? r.text() : Promise.reject(new Error(String(r.status)))));
    const done = (label: string) => {
      btn.textContent = label;
      setTimeout(() => (btn.textContent = "Copy page"), 2000);
    };
    try {
      if (typeof ClipboardItem !== "undefined" && navigator.clipboard?.write) {
        await navigator.clipboard.write([new ClipboardItem({ "text/plain": text().then((t) => new Blob([t], { type: "text/plain" })) })]);
      } else {
        await navigator.clipboard.writeText(await text());
      }
      done("Copied");
    } catch {
      done("Copy failed");
    }
  });

  // Marks the section being read in the "On this page" rail: the last target
  // whose top has passed under the nav. A tab label and its steps count only
  // while its tab is open, and a closed tab's steps are hidden.
  let queued = 0;
  function mark() {
    queued = 0;
    const rail = document.querySelector<HTMLElement>("[data-onpage]");
    if (!rail || !rail.offsetParent) return;
    for (const li of rail.querySelectorAll<HTMLElement>("li[data-in-tab]")) li.hidden = !!document.getElementById(li.dataset.inTab!)?.hidden;
    const links = [...rail.querySelectorAll<HTMLAnchorElement>("li:not([hidden]) > a[href^='#']")];
    const line = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) + 24 || 96;
    let active: HTMLAnchorElement | undefined;
    for (const a of links) {
      const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (!el || el.hidden) continue;
      const box = el.matches("[role=tabpanel]") ? el.closest("[data-tabs]") ?? el : el;
      if (box.getBoundingClientRect().top <= line) active = a;
    }
    active ??= links[0];
    for (const a of links) a.toggleAttribute("data-active", a === active);
  }
  const queue = () => (queued ||= requestAnimationFrame(mark));
  addEventListener("scroll", queue, { passive: true });
  addEventListener("resize", queue);
  addEventListener("hashchange", queue);
  document.addEventListener("docs:tab", queue);
  document.addEventListener("astro:page-load", queue);
</script>

<style>
  .doc :global(.h-anchor) {
    color: inherit;
    text-decoration: none;
  }
  .doc :global(.h-anchor)::after {
    content: "#";
    margin-left: 0.4em;
    color: var(--text-faint);
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .doc :global(.h-anchor:focus-visible)::after {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .doc :global(.h-anchor:hover)::after {
      opacity: 1;
    }
  }
  /* Touch: padding on the inline link grows its hit area to 44px without
     moving a line. It grows up, into the heading's top margin; a heading
     right under another one grows down instead, so the two never overlap. */
  @media (pointer: coarse) {
    .doc :global(.h-anchor) {
      padding-top: calc(2.75rem - 1.15em);
    }
    .doc :global(:is(h2, h3) + h3 .h-anchor) {
      padding-top: 0;
      padding-bottom: calc(2.75rem - 1.15em);
    }
  }

  .docs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: calc(var(--nav-h) + 1.25rem);
    padding-bottom: 5rem;
  }
  @media (min-width: 1024px) {
    .docs {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 4rem;
      padding-top: calc(var(--nav-h) + 3rem);
    }
  }
  .docs__body {
    min-width: 0;
  }

  /* ---------- Sidebar (wide screens) ---------- */
  .docs__side {
    display: none;
  }
  @media (min-width: 1024px) {
    .docs__side {
      display: block;
    }
    /* Sticky rail: search on top, the page list scrolls beneath it. The list
       scrolls, not the rail, so the search results can overflow the rail. */
    .docs__rail {
      position: sticky;
      top: calc(var(--nav-h) + 3rem);
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-height: calc(100dvh - var(--nav-h) - 4rem);
    }
    .docs__toc {
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      /* The scroll position carried across a page swap stays put while the
         fonts settle; anchoring would move the list by a wrapped row. */
      overflow-anchor: none;
      scrollbar-width: thin;
      scrollbar-color: var(--line-strong) transparent;
      padding-bottom: 1rem;
      /* Room for the links' 12px left bleed (the current-page marker), so
         the scroller does not clip it. */
      padding-left: 0.75rem;
      margin-left: -0.75rem;
    }
    /* The ring sits inside the link, so the scroller cannot clip it. */
    .docs__toc .docs__link:focus-visible {
      outline-offset: -2px;
    }
  }
  .docs__group + .docs__group {
    margin-top: 1.5rem;
  }
  .docs__group-label {
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .docs__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .docs__link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2rem;
    padding-left: 0.75rem;
    margin-left: -0.75rem;
    font-size: var(--fs-base);
    color: var(--text-2);
    border-radius: var(--radius-sm);
    transition: color var(--hover-out) ease;
  }
  .docs__link[aria-current="page"] {
    color: var(--text);
    font-weight: 520;
  }
  .docs__link[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    border-radius: 1px;
    background: var(--text);
  }
  @media (pointer: coarse) {
    .docs__link {
      min-height: 2.75rem;
    }
    .docs__link:active {
      color: var(--text);
      transition-duration: 0s;
    }
    .docs__menu-sum:active {
      background: rgba(255, 255, 255, 0.04);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .docs__link:hover {
      color: var(--text);
      transition-duration: var(--hover-in);
    }
  }

  /* ---------- Menu (narrow screens) ---------- */
  .docs__menu {
    margin-bottom: 2rem;
    border-radius: var(--radius);
    background: var(--term);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  @media (min-width: 1024px) {
    .docs__menu {
      display: none;
    }
  }
  .docs__menu-sum {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    font-size: var(--fs-base);
    user-select: none;
  }
  .docs__menu-sum::-webkit-details-marker {
    display: none;
  }
  .docs__menu-kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .docs__menu-current {
    flex: 1;
    min-width: 0;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .docs__menu-chev {
    flex: none;
    color: var(--text-muted);
    transition: transform 200ms var(--ease-out);
  }
  .docs__menu[open] .docs__menu-chev {
    transform: rotate(180deg);
  }
  /* The list scrolls inside the open menu, so it never runs screens long:
     with the bar and the search (6.5rem) the open menu is at most 70dvh. */
  .docs__menu-list {
    max-height: min(70dvh - 6.5rem, 32rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.25rem 1rem 1rem;
    border-top: 1px solid var(--line);
  }
  .docs__menu-search {
    padding: 0.75rem 1rem 0;
    border-top: 1px solid var(--line);
  }
  .docs__menu-search + .docs__menu-list {
    border-top: 0;
  }
  /* Each group folds; the one holding this page starts open. */
  .docs__fold:first-child {
    margin-top: 0.25rem;
  }
  .docs__fold + .docs__fold {
    border-top: 1px solid var(--line);
  }
  .docs__fold-sum {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .docs__fold-sum::-webkit-details-marker {
    display: none;
  }
  .docs__fold[open] > .docs__fold-sum {
    color: var(--text);
  }
  .docs__fold-chev {
    flex: none;
    transition: transform 200ms var(--ease-out);
  }
  .docs__fold[open] .docs__fold-chev {
    transform: rotate(180deg);
  }
  .docs__fold > ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0.75rem;
  }
  .docs__menu-list .docs__link {
    margin-left: 0;
  }
  .docs__menu-list .docs__link[aria-current="page"]::before {
    left: -0.75rem;
    margin-left: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .docs__menu-chev,
    .docs__fold-chev,
    .docs__link,
    .onpage__link {
      transition: none;
    }
  }

  /* ---------- On this page (1280px and wider) ---------- */
  .onpage {
    display: none;
  }
  @media (min-width: 1280px) {
    .docs {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: 3rem;
    }
    .docs__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 11rem;
      column-gap: 2.5rem;
      align-items: start;
    }
    .docs__body > main {
      grid-column: 1;
      grid-row: 1;
    }
    .onpage {
      display: block;
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--nav-h) + 3rem);
      max-height: calc(100dvh - var(--nav-h) - 4rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--line-strong) transparent;
    }
  }
  .onpage__title {
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .onpage ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .onpage__link {
    display: block;
    margin-left: -1px;
    padding: 0.3rem 0 0.3rem 0.75rem;
    border-left: 1px solid transparent;
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: var(--text-muted);
    transition: color var(--hover-out) ease;
  }
  .onpage__link--tab {
    padding-left: 1.5rem;
  }
  .onpage__link--step {
    padding-left: 2.25rem;
  }
  .onpage__link[data-active] {
    color: var(--text);
