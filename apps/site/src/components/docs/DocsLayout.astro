---
// Docs shell: the site Layout and Nav, a sidebar on wide screens, a disclosure
// menu on narrow ones (works without JS), the page, then prev/next. Title and
// description come from nav.ts so the sidebar, <title> and llms.txt agree.
// A page that sits under a nav.ts entry without its own sidebar row (one CLI
// command, /docs/cli/<name>) passes `page` and `parent`, and its own prev/next:
// the sidebar and the breadcrumbs then point at the parent.
import { existsSync } from "node:fs";
import { join } from "node:path";
import Layout from "../../layouts/Layout.astro";
import Nav from "../Nav.astro";
import Search from "./Search.astro";
import { SITE } from "../../data/site";
import { DOC_GROUPS, docPage, neighbours, type DocPage } from "./nav";
import { techArticleSchema, faqSchema } from "../../lib/schema";
import { pageLastmod } from "../../lib/lastmod.mjs";
import "../../styles/doc.css";

interface Props {
  /** Extra JSON-LD for this page (the FAQ page passes its questions). */
  schemas?: Record<string, unknown>[];
  page?: DocPage;
  parent?: DocPage;
  prev?: DocPage;
  next?: DocPage;
}
const { schemas = [] } = Astro.props;

const path = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, "") : Astro.url.pathname;
const page = Astro.props.page ?? docPage(path);
const { parent } = Astro.props;
const current = parent ?? page;
const { prev, next } = Astro.props.page ? Astro.props : neighbours(path);
const isIndex = page.path === "/docs";
const title = page.metaTitle ?? (isIndex ? `${SITE.name} docs: observability and evals for any AI agent` : `${page.title} · ${SITE.name} docs`);
const breadcrumbs = isIndex
  ? [{ name: "Docs", path: "/docs" }]
  : [
      { name: "Docs", path: "/docs" },
      ...(parent ? [{ name: parent.label, path: parent.path }] : []),
      { name: page.label, path: page.path },
    ];
// Title card from scripts/gen-og.mjs (npm run og).
const card = (p: DocPage) => `/og/${p.path === "/docs" ? "docs" : `docs-${p.path.slice("/docs/".length).replace(/\//g, "-")}`}.png`;
// A page without a card yet uses its parent's, or the site card.
const ogImage = [card(page), ...(parent ? [card(parent)] : [])].find((c) => existsSync(join(process.cwd(), "public", c))) ?? "/og-image.png";
const article = techArticleSchema({ ...page, image: ogImage, dateModified: pageLastmod(page.path) });

// Headings link to themselves (#id), rendered into the HTML, so no script needed.
const body = (await Astro.slots.render("default")).replace(
  /<(h[23]) id="([^"]+)"([^>]*)>([\s\S]*?)<\/\1>/g,
  (_, tag, id, rest, inner) => `<${tag} id="${id}"${rest}><a class="h-anchor" href="#${id}">${inner}</a></${tag}>`,
);

// A "## Questions" section whose ### headings are questions is shown on the
// page as Q&A, so it is also marked up as FAQPage, word for word.
const questions = body.match(/<h2 id="questions"[^>]*>[\s\S]*?(?=<h2[ >]|$)/)?.[0] ?? "";
const faq = [...questions.matchAll(/<h3 [^>]*>([\s\S]*?)<\/h3>([\s\S]*?)(?=<h3[ >]|$)/g)]
  .map((m) => ({ q: m[1]!, a: m[2]! }))
  .filter((f) => f.q.trim().endsWith("?</a>") || f.q.trim().endsWith("?"));
const faqSchemas = faq.length ? [faqSchema(faq)] : [];
---

<Layout title={title} description={page.summary} breadcrumbs={breadcrumbs} image={ogImage} schemas={[article, ...faqSchemas, ...schemas]}>
  <Nav />
  <div class="wrap docs">
    <aside class="docs__side" aria-label="Docs">
      <div class="docs__rail">
      <Search id="side" />
      <nav class="docs__toc">
        {
          DOC_GROUPS.map((g) => (
            <div class="docs__group">
              <p class="docs__group-label">{g.label}</p>
              <ul>
                {g.pages.map((p) => (
                  <li>
                    <a href={p.path} class="docs__link" aria-current={p.path === current.path ? "page" : undefined}>
                      {p.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
      </div>
    </aside>

    <div class="docs__body">
      <details class="docs__menu" data-docs-menu>
        <summary class="docs__menu-sum">
          <span class="docs__menu-kicker">Docs</span>
          <span class="docs__menu-current">{current.label}</span>
          <svg class="docs__menu-chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
            <path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <Search id="menu" class="docs__menu-search search--fill" />
        <nav class="docs__menu-list" aria-label="Docs">
          {
            DOC_GROUPS.map((g) => (
              <div class="docs__group">
                <p class="docs__group-label">{g.label}</p>
                <ul>
                  {g.pages.map((p) => (
                    <li>
                      <a href={p.path} class="docs__link" aria-current={p.path === current.path ? "page" : undefined}>
                        {p.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>

      <main id="main" class="doc" data-pagefind-body>
        <h1>{page.title}</h1>
        <p class="lede doc__lede">{page.summary}</p>
        <Fragment set:html={body} />

        {
          (prev || next) && (
            <nav class="pager" aria-label="Previous and next page" data-agent-skip data-pagefind-ignore>
              {prev ? (
                <a href={prev.path} class="pager__link" rel="prev">
                  <span class="pager__dir">Previous</span>
                  <span class="pager__title">{prev.label}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a href={next.path} class="pager__link pager__link--next" rel="next">
                  <span class="pager__dir">Next</span>
                  <span class="pager__title">{next.label}</span>
                </a>
              )}
            </nav>
          )
        }
      </main>
    </div>
  </div>
</Layout>

<style>
  .doc :global(.h-anchor) {
    color: inherit;
    text-decoration: none;
  }
  .doc :global(.h-anchor)::after {
    content: "#";
    margin-left: 0.4em;
    color: var(--text-faint);
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .doc :global(.h-anchor:focus-visible)::after {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .doc :global(.h-anchor:hover)::after {
      opacity: 1;
    }
  }
  /* Touch: padding on the inline link grows its hit area to 44px without
     moving a line. It grows up, into the heading's top margin; a heading
     right under another one grows down instead, so the two never overlap. */
  @media (pointer: coarse) {
    .doc :global(.h-anchor) {
      padding-top: calc(2.75rem - 1.15em);
    }
    .doc :global(:is(h2, h3) + h3 .h-anchor) {
      padding-top: 0;
      padding-bottom: calc(2.75rem - 1.15em);
    }
  }

  .docs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: calc(var(--nav-h) + 1.25rem);
    padding-bottom: 5rem;
  }
  @media (min-width: 1024px) {
    .docs {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 4rem;
      padding-top: calc(var(--nav-h) + 3rem);
    }
  }
  .docs__body {
    min-width: 0;
  }

  /* ---------- Sidebar (wide screens) ---------- */
  .docs__side {
    display: none;
  }
  @media (min-width: 1024px) {
    .docs__side {
      display: block;
    }
    /* Sticky rail: search on top, the page list scrolls beneath it. The list
       scrolls, not the rail, so the search results can overflow the rail. */
    .docs__rail {
      position: sticky;
      top: calc(var(--nav-h) + 3rem);
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-height: calc(100dvh - var(--nav-h) - 4rem);
    }
    .docs__toc {
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--line-strong) transparent;
      padding-bottom: 1rem;
    }
  }
  .docs__group + .docs__group {
    margin-top: 1.5rem;
  }
  .docs__group-label {
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .docs__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .docs__link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2rem;
    padding-left: 0.75rem;
    margin-left: -0.75rem;
    font-size: var(--fs-base);
    color: var(--text-2);
    border-radius: var(--radius-sm);
    transition: color var(--hover-out) ease;
  }
  .docs__link[aria-current="page"] {
    color: var(--text);
    font-weight: 520;
  }
  .docs__link[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    border-radius: 1px;
    background: var(--text);
  }
  @media (pointer: coarse) {
    .docs__link {
      min-height: 2.75rem;
    }
    .docs__link:active {
      color: var(--text);
      transition-duration: 0s;
    }
    .docs__menu-sum:active {
      background: rgba(255, 255, 255, 0.04);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .docs__link:hover {
      color: var(--text);
      transition-duration: var(--hover-in);
    }
  }

  /* ---------- Menu (narrow screens) ---------- */
  .docs__menu {
    margin-bottom: 2rem;
    border-radius: var(--radius);
    background: var(--term);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  @media (min-width: 1024px) {
    .docs__menu {
      display: none;
    }
  }
  .docs__menu-sum {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    font-size: var(--fs-base);
    user-select: none;
  }
  .docs__menu-sum::-webkit-details-marker {
    display: none;
  }
  .docs__menu-kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .docs__menu-current {
    flex: 1;
    min-width: 0;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .docs__menu-chev {
    flex: none;
    color: var(--text-muted);
    transition: transform 200ms var(--ease-out);
  }
  .docs__menu[open] .docs__menu-chev {
    transform: rotate(180deg);
  }
  .docs__menu-list {
    padding: 0.25rem 1rem 1rem;
    border-top: 1px solid var(--line);
  }
  .docs__menu-search {
    padding: 0.75rem 1rem 0;
    border-top: 1px solid var(--line);
  }
  .docs__menu-search + .docs__menu-list {
    border-top: 0;
  }
  .docs__menu-list .docs__group:first-child {
    margin-top: 0.75rem;
  }
  .docs__menu-list .docs__link {
    margin-left: 0;
  }
  .docs__menu-list .docs__link[aria-current="page"]::before {
    left: -0.75rem;
    margin-left: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .docs__menu-chev,
    .docs__link {
      transition: none;
    }
  }

  /* ---------- Pager ---------- */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition:
      background-color var(--hover-out) ease,
      transform 140ms var(--ease-out);
  }
  .pager__link:active {
    transform: scale(0.98);
  }
  .pager__link--next {
    grid-column: 2;
    text-align: right;
  }
  .pager__dir {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .pager__title {
    color: var(--text);
    font-weight: 520;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (hover: hover) and (pointer: fine) {
    .pager__link:hover {
      background: var(--term);
      transition-duration: var(--hover-in);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pager__link {
      transition: none;
    }
    .pager__link:active {
      transform: none;
    }
  }
</style>
