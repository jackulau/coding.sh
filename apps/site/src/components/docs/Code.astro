---
// A copyable code block in the same frame as the install line: a title bar
// with a Copy button, then a body that scrolls sideways inside its own box.
// `code` is the exact text copied, so what you paste is what you read.
interface Props {
  code: string;
  /** Title bar text: a file name, a shell, a language. */
  title?: string;
  class?: string;
}
const { code, title = "shell", class: klass } = Astro.props;
const text = code.replace(/^\n+|\s+$/g, "");
---

<div class:list={["code", klass]}>
  <div class="code__bar" data-pagefind-ignore>
    <span class="code__title">{title}</span>
    <button type="button" class="code__copy ctl hit" data-code-copy aria-label={`Copy ${title}`} data-agent-skip>
      <span data-copy-label>Copy</span>
    </button>
    <span class="sr-only" role="status" data-code-status data-agent-skip></span>
  </div>
  <pre class="code__body" data-code-text><code>{text}</code></pre>
</div>

<style>
  .code {
    min-width: 0;
  }
  .code__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.5rem;
    padding: 0 0.5rem 0 0.9rem;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: var(--term-bar);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .code__title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .code__copy {
    flex: none;
    min-width: 4.25rem;
    justify-content: center;
  }
  /* Touch: the chip keeps its size inside the 40px bar; .hit gives the 44px target. */
  @media (pointer: coarse) {
    .code__copy.ctl {
      height: 1.75rem;
      padding: 0 0.6rem;
    }
  }
  .code__body {
    margin: 0;
    padding: 0.85rem 0.9rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: var(--term);
    box-shadow: inset 1px 0 0 var(--line-strong), inset -1px 0 0 var(--line-strong), inset 0 -1px 0 var(--line-strong);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--text);
    white-space: pre;
    tab-size: 2;
  }
  .code__body:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: -2px;
  }
  .code__body code {
    font: inherit;
    color: inherit;
  }
</style>

<script>
  // Copy is handled for every block by the delegated handler in Nav.astro.
  // A body wider than its box scrolls sideways; only then is it a tab stop, so
  // keyboard users can scroll it with the arrow keys (WCAG 2.1.1). No edge
  // fade: the border is an inset shadow on the pre, and a mask would fade it too.
  // A ResizeObserver reports after the browser's own layout, so the widths are
  // read without forcing one; all reads come before any write, and a body is
  // written only when its state changes.
  const watch = new ResizeObserver((entries) => {
    const bodies = entries.map((e) => e.target as HTMLElement);
    const over = bodies.map((pre) => pre.scrollWidth > pre.clientWidth + 1);
    bodies.forEach((pre, i) => {
      if (over[i] === pre.hasAttribute("tabindex")) return;
      if (over[i]) pre.tabIndex = 0;
      else pre.removeAttribute("tabindex");
    });
  });
  document.addEventListener("astro:page-load", () => {
    watch.disconnect();
    for (const pre of document.querySelectorAll(".code__body")) watch.observe(pre);
  });
</script>
