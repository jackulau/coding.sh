---
// The coding.sh mark: one solid isometric cube, white top and two grey faces.
// Drawn by src/lib/cube.ts, the same cube as the favicon and the hero field.
import { cubeSvg } from "../lib/cube";

interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: klass } = Astro.props;
const m = cubeSvg();
---

<svg
  class:list={["mark", klass]}
  width={size}
  height={size}
  viewBox={`0 0 ${m.width} ${m.height}`}
  aria-hidden="true"
  focusable="false"
  set:html={m.body}
/>

<style>
  .mark {
    display: block;
    flex: none;
  }
</style>
