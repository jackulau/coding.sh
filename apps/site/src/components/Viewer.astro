  }
  .vw__insp {
    margin-top: auto;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-2);
    min-height: 2.6rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .wf {
    margin-bottom: 1rem;
  }

  @media (max-width: 1023px) {
    .vw__body {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .vw__side {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 0.6rem 0 0.6rem;
    }
    .vw__side-head {
      padding-inline: 1rem;
    }
    .vw__list {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding: 0 1rem;
      scroll-padding-inline: 1rem;
    }
    .vw__list::-webkit-scrollbar {
      display: none;
    }
    .vw__sess {
      flex: none;
      width: 15rem;
      scroll-snap-align: start;
    }
    .vw__panel {
      min-height: calc(var(--rows) * 1.875rem + 14rem);
    }
    .vw__exp {
      min-height: 0;
    }
    .vw__exp .vw__panel {
      min-height: 0;
    }
  }
  @media (max-width: 899px) {
    .vw__rec-path {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .vw__rec-id,
    .vw__tag,
    .vw__brand-name {
      display: none;
    }
    .vw__top {
      gap: 0.6rem;
    }
    .vw__nav button {
      padding-inline: 0.45rem;
    }
    .vw__rec {
      gap: 0.6rem;
    }
    /* Phones: only the selected session, with previous / next. */
    .vw__list {
      overflow: visible;
      padding: 0 0.75rem;
    }
    .vw__sess {
      width: 100%;
      flex: 1 1 auto;
    }
    .vw__sess[aria-selected="false"] {
      display: none;
    }
    .vw__side-head {
      align-items: center;
      padding: 0 0.75rem 0.5rem;
    }
    .vw__step {
      display: inline-flex;
      gap: 0.35rem;
    }
    .vw__step button {
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: var(--radius-sm);
      font-size: 1.1rem;
      line-height: 1;
      color: var(--text-2);
      box-shadow: inset 0 0 0 1px var(--line-strong);
    }
    .vw__step button:active {
      background: var(--raised);
    }
    .vw__top {
      padding: 0 0.75rem;
    }
    .vw__panel {
      padding: 0.85rem 0.75rem;
      min-height: 0;
    }
    /* Phones: one row of three stats, and the waterfall scrolls inside a
       fixed box, so the whole viewer stays about one screen tall. */
    .vw__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    [data-pane="sessions"] .vw__stats div:nth-child(3),
    .vw__exp .vw__stats div:nth-child(2) {
      display: none;
    }
    .vw__stats div {
      padding: 0.55rem 0.6rem;
    }
    .vw__stats dt {
      font-size: 10.5px;
      white-space: normal;
      line-height: 1.3;
      min-height: 2.6em;
    }
    .vw__stats div {
      min-width: 0;
    }
    .vw__stats dd {
      font-size: var(--fs-sm);
    }
    [data-pane="sessions"] .vw__facts div:nth-child(3),
    .vw__exp .vw__facts div:nth-child(2) {
      display: none;
    }
    .wf__rows {
      max-height: 19rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      mask-image: linear-gradient(to bottom, #000 85%, transparent);
    }
    .vw__exp .td__runs,
    .vw__exp .td__arm {
      min-width: 0;
    }
    /* Each span's label gets the full width, its bar sits underneath. */
    .wf {
      --name: 0px;
      --dur: 0px;
      --gap: 0px;
    }
    .wf__axis {
      grid-template-columns: minmax(0, 1fr);
      padding: 0 0.25rem 0 0.4rem;
    }
    .wf__axis-pad,
    .wf__axis > span:last-child {
      display: none;
    }
    .wf .wf__btn {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "name dur" "track track";
      gap: 0.2rem 0.75rem;
      height: auto;
      padding-block: 0.4rem;
    }
    .wf__name {
      grid-area: name;
      gap: 0.4rem;
    }
    .wf__track {
      grid-area: track;
      height: 14px;
    }
    .wf__dur {
      grid-area: dur;
    }
    .is-child .wf__name {
      padding-left: 0.9rem;
    }
    .wf__play {
      top: 1.75rem;
    }
    .wf__tick:not(:first-child):not(:last-child):nth-child(2n) {
      display: none;
    }
  }
  @media (pointer: coarse) {
    .wf__btn {
      height: 2.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wf__chev {
      transition: none;
    }
  }
</style>

<script>
  function setupViewer() {
    for (const root of document.querySelectorAll<HTMLElement>("[data-viewer]")) {
      if (root.dataset.bound) continue;
      root.dataset.bound = "1";
      const rec = {
        id: root.querySelector<HTMLElement>("[data-rec-id]"),
        tc: root.querySelector<HTMLElement>("[data-rec-tc]"),
      };

      // The playhead runs once, the first time the first waterfall is in view.
      // Until then html.js + [data-play] holds the bars at zero width (CSS).
      const wf = root.querySelector<HTMLElement>(".wf[data-play]");
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const tc = (sec: number) => {
        const t = Math.max(0, Math.round(sec));
        const p = (n: number) => String(n).padStart(2, "0");
        return `${p(Math.floor(t / 3600))}:${p(Math.floor(t / 60) % 60)}:${p(t % 60)}`;
      };
      const first = root.querySelector<HTMLElement>('[role="tab"][data-rec-s]');
      const total = Number(first?.dataset.recS ?? 0);
      let io: IntersectionObserver | undefined;
      let frame = 0;
      const timers: number[] = [];
      const signal = (tone: "pass" | "fail") => document.dispatchEvent(new CustomEvent("cs:signal", { detail: tone }));
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        io?.disconnect();
        cancelAnimationFrame(frame);
        timers.forEach(clearTimeout);
        wf?.classList.remove("is-playing");
        wf?.classList.add("is-done");
        // The strip always ends on the selected session's full length.
        const on = root.querySelector<HTMLElement>('[role="tab"][aria-selected="true"][data-rec-tc]');
        if (rec.tc && on) rec.tc.textContent = on.dataset.recTc ?? "";
      };
      if (wf && !still && "IntersectionObserver" in window) {
        // The recorder starts at zero and counts up with the playhead.
        if (rec.tc) rec.tc.textContent = tc(0);
        io = new IntersectionObserver(
          ([e]) => {
            if (!e.isIntersecting) return;
            io?.disconnect();
            wf.classList.add("is-playing");
            const T = (parseFloat(getComputedStyle(wf).getPropertyValue("--T")) || 2.4) * 1000;
            const t0 = performance.now();
            const tick = (now: number) => {
              const k = Math.min(1, (now - t0) / T);
              if (rec.tc) rec.tc.textContent = tc(k * total);
              if (k < 1) frame = requestAnimationFrame(tick);
            };
            frame = requestAnimationFrame(tick);
            // A failed span turns red as the playhead leaves it; the field blinks with it.
            for (const bar of wf.querySelectorAll<HTMLElement>(".is-err .wf__bar")) {
              const cs = getComputedStyle(bar);
              const at = (parseFloat(cs.getPropertyValue("--a")) + parseFloat(cs.getPropertyValue("--w"))) * T;
              timers.push(window.setTimeout(() => signal("fail"), at));
            }
            timers.push(
              window.setTimeout(() => {
                if (wf.hasAttribute("data-ok")) signal("pass");
                finish();
              }, T + 250),
            );
          },
          { threshold: 0.35 },
        );
        io.observe(wf);
      } else finish();

      // Phones: start with subagents folded so the failed test and its fix are on screen.
      if (matchMedia("(max-width: 639px)").matches) {
        for (const btn of root.querySelectorAll<HTMLButtonElement>(".wf__btn[data-toggle]")) {
          btn.setAttribute("aria-expanded", "false");
          for (const row of root.querySelectorAll<HTMLElement>(`[data-group="${btn.dataset.toggle}"]`)) row.hidden = true;
        }
      }

      // Each list (sessions, experiments) is its own tab group.
      for (const list of root.querySelectorAll<HTMLElement>('[role="tablist"]')) {
        const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
        const select = (tab: HTMLButtonElement, focus = false) => {
          for (const t of tabs) {
            const on = t === tab;
            t.setAttribute("aria-selected", String(on));
            t.tabIndex = on ? 0 : -1;
            const panel = root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`);
            if (panel) panel.hidden = !on;
          }
          // The recorder strip follows the selected session.
          if (tab.dataset.recId) {
            if (rec.id) {
              rec.id.textContent = tab.dataset.recId;
              rec.id.classList.toggle("sid", tab === first);
            }
            if (rec.tc) rec.tc.textContent = tab.dataset.recTc ?? "";
          }
          finish(); // a reader who picks a session has moved past the intro
          if (focus) tab.focus();
        };
        // Phones show one session at a time, with previous / next.
        list.closest(".vw__side")?.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
          b.addEventListener("click", () => {
            const at = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
            select(tabs[(at + Number(b.dataset.step) + tabs.length) % tabs.length]);
          }),
        );
        tabs.forEach((tab, i) => {
          tab.addEventListener("click", () => select(tab));
          tab.addEventListener("keydown", (e) => {
            const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
            if (step === undefined) return;
            e.preventDefault();
            select(tabs[(i + step + tabs.length) % tabs.length], true);
          });
        });
      }

      // Top nav: Sessions | Experiments.
      const views = [...root.querySelectorAll<HTMLButtonElement>("[data-view]")];
      for (const v of views) {
        v.addEventListener("click", () => {
          for (const o of views) {
            const on = o === v;
            o.classList.toggle("is-on", on);
            o.setAttribute("aria-pressed", String(on));
          }
          for (const pane of root.querySelectorAll<HTMLElement>("[data-pane]")) pane.hidden = pane.dataset.pane !== v.dataset.view;
        });
      }

      root.addEventListener("click", (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>(".wf__btn");
        if (!btn) return;
        const panel = btn.closest<HTMLElement>(".vw__panel");
        if (!panel) return;
        for (const b of panel.querySelectorAll(".wf__btn[aria-pressed='true']")) b.setAttribute("aria-pressed", "false");
        btn.setAttribute("aria-pressed", "true");
        const out = panel.querySelector<HTMLElement>("[data-insp-out]");
        if (out) out.textContent = btn.dataset.insp ?? "";
        const gid = btn.dataset.toggle;
        if (gid) {
          const open = btn.getAttribute("aria-expanded") !== "true";
          btn.setAttribute("aria-expanded", String(open));
          for (const row of panel.querySelectorAll<HTMLElement>(`[data-group="${gid}"]`)) row.hidden = !open;
        }
      });
    }
  }
  document.addEventListener("astro:page-load", setupViewer);
</script>
