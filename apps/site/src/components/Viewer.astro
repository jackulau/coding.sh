---
// A working sample of the local viewer (`coding.sh ui`), rendered in full at
// build time so it is never empty on first paint. Six sessions on the left;
// the selected one shows its facts and latency stats on one key/value line, then
// a waterfall of model calls, tool calls and a nested subagent. The top bar is
// a recorder strip (REC, session id, timecode). The first time the waterfall
// scrolls into view a playhead runs across it once: every span is already
// there as a faint outline, each one fills as the playhead passes it, and the
// timecode runs up with it. That is the one animation on the page, because it
// stands for real time. Each failed span, and the passing end, also fire a
// "cs:signal" event that the cube field answers with one blink of that colour.
// Under reduced motion, or without JS, it renders finished. The
// script also switches sessions, expands subagents and fills the inspector.
// All data is sample data (src/data/sample.ts).
import Mark from "./Mark.astro";
import TaskDeltas from "./TaskDeltas.astro";
import { EXPERIMENTS, summarize } from "../data/experiments";
import { SESSIONS, sessionStats, flatten, fmtDuration, fmtCompact, fmtCost, type Span } from "../data/sample";

const NICE = [1, 2, 5, 10, 15, 20, 30, 60];
const ticksFor = (total: number) => {
  const step = NICE.find((s) => total / s <= 5) ?? 60;
  const out: number[] = [];
  for (let t = 0; t <= total + 1e-9; t += step) out.push(t);
  return out;
};
const tickLabel = (t: number) => (t >= 60 ? `${Math.floor(t / 60)}m${t % 60 ? ` ${t % 60}s` : ""}` : `${t}s`);

const ms = (s: number) => `${Math.round(s * 1000)}ms`;
// Inspector lines are key/value pairs, like the facts line above them.
const kv = (...pairs: [string, string | number][]) => pairs.map(([k, v]) => `${k} ${v}`).join("   ");
const inspector = (s: Span) => {
  const d = fmtDuration(s.end - s.start);
  if (s.kind === "llm")
    return kv(["llm.call", s.name], ["dur", d], ["ttft", ms(s.ttft ?? 0)], ["in", fmtCompact(s.tin ?? 0)], ["out", fmtCompact(s.tout ?? 0)]);
  if (s.kind === "tool")
    return kv(["tool", `${s.name} ${s.detail ?? ""}`.trim()], ["dur", d], ["exit", s.ok === false ? "1" : "0"]);
  if (s.kind === "subagent") {
    const kids = flatten(s.children ?? []);
    return kv(
      ["subagent", `${s.name}: ${s.detail}`],
      ["dur", d],
      ["llm", kids.filter((k) => k.kind === "llm").length],
      ["tools", kids.filter((k) => k.kind === "tool").length],
      ["kind", "child session"],
    );
  }
  return kv(["user.message", `"${s.detail}"`]);
};
/** Session duration as a recorder timecode, 00:01:08. */
const timecode = (sec: number) => {
  const t = Math.round(sec);
  const p = (n: number) => String(n).padStart(2, "0");
  return `${p(Math.floor(t / 3600))}:${p(Math.floor(t / 60) % 60)}:${p(t % 60)}`;
};

interface Row {
  span: Span;
  depth: number;
  group?: string; // id of the subagent group this row belongs to
  ownsGroup?: string; // id of the group this subagent row toggles
}

const panels = SESSIONS.map((s, si) => {
  const st = sessionStats(s);
  const total = st.duration;
  const rows: Row[] = [];
  s.spans.forEach((sp, i) => {
    if (sp.kind === "subagent") {
      const gid = `wf-${s.id}-${i}`;
      rows.push({ span: sp, depth: 0, ownsGroup: gid });
      (sp.children ?? []).forEach((c) => rows.push({ span: c, depth: 1, group: gid }));
    } else rows.push({ span: sp, depth: 0 });
  });
  // Lead with the failure: the inspector opens on the first failed tool call.
  const pick =
    rows.find((r) => r.span.kind === "tool" && r.span.ok === false) ?? rows.find((r) => r.span.kind === "subagent") ?? rows[1];
  return { s, si, st, total, rows, ticks: ticksFor(total), pick };
});

const maxRows = Math.max(...panels.map((p) => p.rows.length));

const exps = EXPERIMENTS.map((e, i) => ({ e, i, ...summarize(e, 1842 + i) }));
const signed = (n: number) => (n > 0 ? `+${n}` : `${n}`);
const verdictLine = (x: (typeof exps)[number]) => {
  const { st, verdict, costDelta } = x;
  const head = verdict === "inconclusive" ? "not enough data" : verdict;
  return `${head}   diff ${signed(st.diff)} pts   ci95 [${signed(st.diffCI[0])}, ${signed(st.diffCI[1])}]   regressed ${st.regressed}   cost ${signed(costDelta)}%`;
};
// Playhead length: one pass over the first session, in real-time proportion.
const PLAY_S = 2.4;
// The run the page follows from recording to eval to compare.
const THREAD = SESSIONS[0].id;
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(2)}%`;
---

<figure class="vw" data-viewer aria-label="The coding.sh local viewer, with sample data. Click a session or a span.">
  <div class="vw__win">
    <div class="vw__top">
      <span class="vw__brand"><Mark size={14} /> <span class="vw__brand-name">coding.sh</span></span>
      <span class="vw__nav">
        <button type="button" class="is-on" data-view="sessions" aria-pressed="true">Sessions</button>
        <button type="button" data-view="experiments" aria-pressed="false">Experiments</button>
      </span>
      <span class="vw__spacer"></span>
      <span class="vw__rec tnum" aria-label={`Session ${panels[0].s.id}, ${fmtDuration(panels[0].total)}`} data-rec>
        <span class="vw__rec-on"><i class="vw__rec-dot" aria-hidden="true"></i>REC</span>
        <span class="vw__rec-id sid" data-rec-id>{panels[0].s.id}</span>
        <span class="vw__rec-tc" data-rec-tc>{timecode(panels[0].total)}</span>
        <span class="vw__rec-path">~/.coding.sh</span>
      </span>
      <span class="vw__tag">coding.sh ui</span>
    </div>

    <div class="vw__body" data-pane="sessions" style={`--rows:${maxRows}`}>
      <div class="vw__side">
        <p class="vw__side-head">
          <span>Sessions <span class="vw__muted tnum">{SESSIONS.length}</span></span>
          <span class="vw__step">
            <button type="button" data-step="-1" aria-label="Previous session">‹</button>
            <button type="button" data-step="1" aria-label="Next session">›</button>
          </span>
        </p>
        <div class="vw__list" role="tablist" aria-label="Sessions" aria-orientation="vertical">
          {
            panels.map(({ s, si, st, total }) => (
              <button
                type="button"
                role="tab"
                class="vw__sess"
                id={`tab-${s.id}`}
                aria-controls={`panel-${s.id}`}
                aria-selected={si === 0 ? "true" : "false"}
                tabindex={si === 0 ? 0 : -1}
                data-rec-id={s.id}
                data-rec-tc={timecode(total)}
                data-rec-s={Math.round(total)}
              >
                <span class:list={["vw__dot", s.outcome.ok ? "is-pass" : "is-fail"]} aria-hidden="true" />
                <span class="vw__sess-main">
                  <span class="vw__sess-title">{s.title}</span>
                  <span class="vw__sess-meta tnum">
                    <span>{s.agent}</span>
                    <span>{fmtDuration(st.duration)}</span>
                    <span><span class="vw__k">tools</span> {st.toolCalls}</span>
                    {st.toolErrors ? <span class="t-fail"><span class="vw__k">failed</span> {st.toolErrors}</span> : null}
                  </span>
                </span>
                <span class="vw__sess-ago">{s.ago}</span>
              </button>
            ))
          }
        </div>
      </div>

      {
        panels.map(({ s, si, st, total, rows, ticks, pick }) => (
          <section
            class="vw__panel"
            role="tabpanel"
            id={`panel-${s.id}`}
            aria-labelledby={`tab-${s.id}`}
            hidden={si !== 0}
          >
            <div class="vw__head">
              <p class="vw__muted vw__mono">session <span class:list={[s.id === THREAD && "sid"]}>{s.id}</span></p>
              <p class="vw__title">{s.title}</p>
              <dl class="vw__facts">
                <div><dt>agent</dt><dd>{s.agent}</dd></div>
                <div><dt>model</dt><dd>{s.model}</dd></div>
                <div><dt>repo</dt><dd>{s.repo}</dd></div>
                <div>
                  <dt>outcome</dt>
                  <dd class={s.outcome.ok ? "t-pass" : "t-fail"}>{s.outcome.text}</dd>
                </div>
              </dl>
              <dl class="vw__facts vw__facts--stats tnum">
                <div><dt>tokens</dt><dd>{fmtCompact(st.tokensIn)}/{fmtCompact(st.tokensOut)}</dd></div>
                <div><dt>p95</dt><dd>{fmtDuration(st.p95)}</dd></div>
                <div><dt>ttft</dt><dd>{ms(st.ttftP50)}</dd></div>
                <div><dt>cost</dt><dd>{fmtCost(s.costUsd)}</dd></div>
              </dl>
            </div>

            <div class="wf" data-play={si === 0 ? "" : undefined} data-ok={s.outcome.ok ? "" : undefined} style={`--T:${PLAY_S}s`}>
              {si === 0 ? (
                <span class="wf__play" aria-hidden="true">
                  <i />
                </span>
              ) : null}
              <div class="wf__axis" aria-hidden="true">
                <span class="wf__axis-pad">
                  <span><span class="vw__k">llm</span> {st.llmCalls}</span>
                  <span><span class="vw__k">tools</span> {st.toolCalls}</span>
                  {st.subagents ? <span><span class="vw__k">sub</span> {st.subagents}</span> : null}
                </span>
                <span class="wf__ticks">
                  {ticks.map((t) => (
                    <span class="wf__tick tnum" style={`left:${pct(t, total)}`}>{tickLabel(t)}</span>
                  ))}
                </span>
                <span />
              </div>
              <ul class="wf__rows" role="list">
                {rows.map((r) => {
                  const sp = r.span;
                  const isPick = r === pick;
                  const width = Math.max(((sp.end - sp.start) / total) * 100, 0.6);
                  const cls = [
                    "wf__row",
                    `is-${sp.kind}`,
                    sp.ok === false && "is-err",
                    r.depth && "is-child",
                    isPick && "is-picked",
                  ];
                  return (
                    <li class:list={cls} data-group={r.group}>
                      <button
                        type="button"
                        class="wf__btn"
                        data-insp={inspector(sp)}
                        data-toggle={r.ownsGroup}
                        aria-expanded={r.ownsGroup ? "true" : undefined}
                        aria-pressed={isPick ? "true" : "false"}
                      >
                        <span class="wf__name">
                          {sp.kind === "subagent" ? (
                            <svg class="wf__chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                              <path d="M2.5 3.75 5 6.25l2.5-2.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
                            </svg>
                          ) : (
                            <i class="wf__glyph" aria-hidden="true" />
                          )}
                          <span class="wf__label">{sp.kind === "llm" ? "llm.call" : sp.name}</span>
                          <span class="wf__detail">{sp.kind === "llm" ? sp.name.replace(/^claude-/, "") : sp.detail}</span>
                        </span>
                        <span class="wf__track" aria-hidden="true">
                          {si === 0 && sp.kind !== "prompt" ? (
                            <span class="wf__ghost" style={`left:${pct(sp.start, total)};width:${width.toFixed(2)}%`} />
                          ) : null}
                          {sp.kind === "prompt" ? (
                            <span class="wf__pin" style={`left:${pct(sp.start, total)};--a:${(sp.start / total).toFixed(4)}`} />
                          ) : (
                            <span
                              class="wf__bar"
                              style={`left:${pct(sp.start, total)};width:${width.toFixed(2)}%;--a:${(sp.start / total).toFixed(4)};--w:${((sp.end - sp.start) / total).toFixed(4)}`}
                            >
                              {sp.kind === "llm" && sp.ttft ? (
                                <span class="wf__ttft" style={`width:${(((sp.ttft ?? 0) / (sp.end - sp.start)) * 100).toFixed(1)}%`} />
                              ) : null}
                            </span>
                          )}
                        </span>
                        <span class="wf__dur tnum">{sp.kind === "prompt" ? "" : fmtDuration(sp.end - sp.start)}</span>
                      </button>
                    </li>
                  );
                })}
              </ul>
            </div>

            <p class="vw__insp" data-insp-out aria-live="polite">{inspector(pick.span)}</p>
          </section>
        ))
      }
    </div>

    <div class="vw__body vw__exp" data-pane="experiments" hidden style={`--rows:${maxRows}`}>
      <div class="vw__side">
        <p class="vw__side-head">
          <span>Experiments <span class="vw__muted tnum">{exps.length}</span></span>
          <span class="vw__step">
            <button type="button" data-step="-1" aria-label="Previous experiment">‹</button>
            <button type="button" data-step="1" aria-label="Next experiment">›</button>
          </span>
        </p>
        <div class="vw__list" role="tablist" aria-label="Experiments" aria-orientation="vertical">
          {
            exps.map((x) => (
              <button
                type="button"
                role="tab"
                class="vw__sess"
                id={`tab-${x.e.id}`}
                aria-controls={`panel-${x.e.id}`}
                aria-selected={x.i === 0 ? "true" : "false"}
                tabindex={x.i === 0 ? 0 : -1}
              >
                <span class:list={["vw__dot", x.verdict === "better" ? "is-pass" : x.verdict === "worse" ? "is-fail" : "is-flat"]} aria-hidden="true" />
                <span class="vw__sess-main">
                  <span class="vw__sess-title">{x.e.title}</span>
                  <span class="vw__sess-meta tnum">
                    <span>{x.e.bench}</span>
                    <span>{x.st.tasks} tasks × {x.st.runsPerTask}</span>
                    <span class:list={[x.verdict === "better" ? "t-pass" : x.verdict === "worse" ? "t-fail" : ""]}>{signed(x.st.diff)} pts</span>
                  </span>
                </span>
                <span class="vw__sess-ago">{x.e.ago}</span>
              </button>
            ))
          }
        </div>
      </div>

      {
        exps.map((x) => (
          <section class="vw__panel" role="tabpanel" id={`panel-${x.e.id}`} aria-labelledby={`tab-${x.e.id}`} hidden={x.i !== 0}>
            <div class="vw__head">
              <p class="vw__muted vw__mono">experiment {x.e.id}</p>
              <p class="vw__title">{x.e.title}</p>
              <dl class="vw__facts">
                <div><dt>bench</dt><dd>{x.e.bench}</dd></div>
                <div><dt>agent</dt><dd>{x.e.agent}</dd></div>
                <div><dt>A</dt><dd>{x.e.arms.base}</dd></div>
                <div><dt>B</dt><dd>{x.e.arms.cand}</dd></div>
              </dl>
            </div>

            <p class:list={["vw__verdict", "tnum", `is-${x.verdict}`]}>{verdictLine(x)}</p>

            <dl class="vw__stats tnum">
              <div>
                <dt>pass rate</dt>
                <dd>{x.st.baseRate}% <span class="vw__muted">→</span> {x.st.candRate}%</dd>
              </div>
              <div>
                <dt>p (McNemar)</dt>
                <dd>{x.st.p < 0.001 ? "<0.001" : x.st.p.toFixed(3)}</dd>
              </div>
              <div>
                <dt>cost / run</dt>
                <dd>${x.e.cost.base.toFixed(3)} <span class="vw__muted">→</span> ${x.e.cost.cand.toFixed(3)}</dd>
              </div>
              <div>
                <dt>p95 wall time</dt>
                <dd>{x.e.p95s.base}s <span class="vw__muted">→</span> {x.e.p95s.cand}s</dd>
              </div>
            </dl>

            <div class="vw__td">
              <TaskDeltas tasks={x.e.tasks} base="A" cand="B" notes={false} limit={4} />
            </div>

            <p class="vw__insp">coding.sh bench compare {x.e.id}</p>
          </section>
        ))
      }
    </div>
  </div>
</figure>

<style>
  .vw {
    position: relative;
    margin: 0;
    min-width: 0;
  }
  .vw__win {
    background: var(--term);
    border-radius: var(--radius);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      0 40px 120px -40px rgba(0, 0, 0, 0.9),
      0 0 0 6px rgba(255, 255, 255, 0.025);
    overflow: hidden;
    font-size: var(--fs-sm);
  }

  /* top bar */
  .vw__top {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 2.75rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-2);
  }
  .vw__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-weight: 600;
  }
  .vw__nav {
    display: flex;
    gap: 0.25rem;
  }
  .vw__nav button {
    padding: 0.25rem 0.6rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .vw__nav button:hover {
    color: var(--text);
  }
  .vw__nav button:focus-visible {
    outline: 2px solid var(--text-muted);
    outline-offset: 1px;
  }
  .vw__verdict {
    white-space: pre-wrap;
    margin: 0.85rem 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .vw__verdict.is-better {
    color: var(--pass-ink);
  }
  .vw__verdict.is-worse {
    color: var(--fail-ink);
  }
  .vw__td {
    margin-top: 1.25rem;
  }
  .vw__exp .vw__insp {
    color: var(--text-muted);
  }
  .vw__nav .is-on {
    background: var(--raised-2);
    color: var(--text);
  }
  .vw__spacer {
    flex: 1;
  }
  .vw__tag {
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--text-muted);
  }
  /* Recorder strip: REC, session, timecode, where it is stored. The ring is
     white, not red: red means a failure everywhere else on the page. */
  .vw__rec {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .vw__rec-on {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
    letter-spacing: 0.08em;
  }
  .vw__rec-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text);
  }
  @media (prefers-reduced-motion: no-preference) {
    .vw__rec-dot {
      animation: rec-pulse 1s steps(1, end) infinite;
    }
  }
  @keyframes rec-pulse {
    50% {
      opacity: 0.35;
    }
  }
  .vw__rec-tc {
    color: var(--text);
  }
  .vw__k {
    color: var(--text-muted);
  }
  .vw__sess-meta .t-fail .vw__k {
    color: inherit;
    opacity: 0.8;
  }
  .vw__step {
    display: none;
  }

  /* body */
  .vw__body[hidden] {
    display: none;
  }
  .vw__body {
    display: grid;
    grid-template-columns: 17.5rem minmax(0, 1fr);
    min-height: calc(var(--rows) * 1.875rem + 13.5rem);
  }
  .vw__exp {
    min-height: calc(var(--rows) * 1.875rem + 17rem);
  }
  .vw__side {
    border-right: 1px solid var(--line);
    padding: 0.75rem 0.5rem;
    min-width: 0;
  }
  .vw__side-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.25rem 0.6rem 0.6rem;
    font-weight: 560;
  }
  .vw__muted {
    color: var(--text-muted);
    font-weight: 400;
  }
  .vw__mono {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .vw__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .vw__sess {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: start;
    width: 100%;
    padding: 0.6rem 0.6rem;
    text-align: left;
    border-radius: var(--radius-sm);
    color: var(--text-2);
    transition: background-color var(--hover-out) ease;
  }
  .vw__sess[aria-selected="true"] {
    background: var(--raised);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .vw__sess:hover {
      background: var(--raised);
      transition-duration: var(--hover-in);
    }
  }
  .vw__dot {
    width: 7px;
    height: 7px;
    margin-top: 0.4rem;
  }
  .vw__dot.is-pass {
    background: var(--pass);
  }
  .vw__dot.is-fail {
    background: var(--fail);
  }
  .vw__dot.is-flat {
    box-shadow: inset 0 0 0 1px var(--text-muted);
  }
  .vw__sess-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .vw__sess-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
  }
  .vw__sess-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  .vw__sess-ago {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
    padding-top: 0.1rem;
  }

  /* panel */
  .vw__panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1rem 1.25rem 1rem;
  }
  .vw__panel[hidden] {
    display: none;
  }
  .vw__title {
    margin-top: 0.15rem;
    font-size: 1.0625rem;
    font-weight: 560;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .vw__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .vw__facts div {
    display: flex;
    gap: 0.4rem;
  }
  .vw__facts dt {
    color: var(--text-muted);
  }
  .vw__facts dd {
    margin: 0;
    color: var(--text-2);
  }
  .vw__facts dd.t-pass {
    color: var(--pass-ink);
  }
  .vw__facts dd.t-fail {
    color: var(--fail-ink);
  }
  .vw__facts--stats {
    margin-top: 0.3rem;
  }
  .vw__facts--stats dd {
    color: var(--text);
  }
  .vw__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 1rem 0 0;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .vw__stats div {
    padding: 0.6rem 0.8rem;
    min-width: 0;
  }
  .vw__stats div + div {
    border-left: 1px solid var(--line);
  }
  .vw__stats dt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .vw__stats dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* waterfall */
  .wf {
    --name: 15.5rem;
    --dur: 3.5rem;
    --gap: 0.75rem;
    position: relative;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .wf__axis-pad {
    display: flex;
    gap: 0.9rem;
  }

  /* The playhead: a 1px line over the track column, 0s to the end in
     --T, linear because it is time. Bars grow from their start as it passes;
     a failed tool turns red only once the playhead reaches its end. */
  .wf__play {
    position: absolute;
    z-index: 1;
    top: 1.75rem;
    bottom: 0;
    left: calc(0.4rem + var(--name) + var(--gap));
    right: calc(0.25rem + var(--dur) + var(--gap));
    pointer-events: none;
    opacity: 0;
  }
  .wf__play i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 1px;
    background: var(--text);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
  }
  /* Before the playhead reaches a span, its outline is already there, so the
     whole trace reads on first paint; only the fill waits for the playhead. */
  .wf__ghost {
    display: none;
    position: absolute;
    top: 50%;
    height: 10px;
    min-width: 3px;
    translate: 0 -50%;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
  }
  .is-subagent .wf__ghost {
    height: 14px;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .wf[data-play]:not(.is-done) .wf__ghost {
      display: block;
    }
    :global(html.js) .wf[data-play]:not(.is-done) .wf__bar {
      transform: scaleX(0);
    }
    :global(html.js) .wf[data-play]:not(.is-done) .wf__pin {
      opacity: 0;
    }
    :global(html.js) .wf[data-play]:not(.is-done) .is-err .wf__bar {
      background: #55555c;
    }
    .wf.is-playing .wf__play {
      animation: wf-play var(--T) linear both;
    }
    .wf.is-playing .wf__bar {
      transform-origin: left center;
      animation: wf-grow calc(max(var(--w) * var(--T), 60ms)) linear calc(var(--a) * var(--T)) both;
    }
    .wf.is-playing .is-err .wf__bar {
      animation-name: wf-grow-err;
    }
    .wf.is-playing .wf__pin {
      animation: wf-pin 1ms linear calc(var(--a) * var(--T)) both;
    }
  }
  @keyframes wf-play {
    0% {
      opacity: 1;
      transform: translateX(0);
    }
    96% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(100%);
    }
  }
  @keyframes wf-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes wf-grow-err {
    0% {
      transform: scaleX(0);
      background: #55555c;
    }
    99% {
      background: #55555c;
    }
    100% {
      transform: scaleX(1);
      background: var(--fail);
    }
  }
  @keyframes wf-pin {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
