// The Cloudflare fallback for the site. coding.sh is served by Vercel
// (scripts/vercel-config.mjs, .github/workflows/site.yml). This worker holds no
// custom domain, so `npx wrangler deploy` from apps/site after `npm run build`
// updates only its workers.dev URL. To serve coding.sh from it again: remove the
// domains from the Vercel project, delete the Vercel DNS records, and add
//   "routes": [{ "pattern": "coding.sh", "custom_domain": true },
//              { "pattern": "www.coding.sh", "custom_domain": true }]
//
// worker/index.ts runs first on every request: www and http 301 to
// https://coding.sh, /sitemap.xml points at the sitemap index, a moved page 301s
// to its new path, /404 gets a 404 status. Everything else falls through to the static assets (and _headers).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coding-sh-site",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    // Pages live at /docs/quickstart (no trailing slash): the form every
    // internal link, the canonical tags and the sitemap use (trailingSlash:
    // "never" in astro.config.mjs). /docs/quickstart/ redirects to it.
    "html_handling": "drop-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true
}
