// The Cloudflare fallback for the site. coding.sh is served by Vercel
// (scripts/vercel-config.mjs, .github/workflows/site.yml). This worker holds no
// custom domain, so `npx wrangler deploy` from apps/site after `npm run build`
// updates only its workers.dev URL. To serve coding.sh from it again: remove the
// domains from the Vercel project, delete the Vercel DNS records, and add
//   "routes": [{ "pattern": "coding.sh", "custom_domain": true },
//              { "pattern": "www.coding.sh", "custom_domain": true }]
//
// worker/index.ts runs first on every page and text path: www and http 301 to
// https://coding.sh, /sitemap.xml points at the sitemap index, a moved page 301s
// to its new path, /404 gets a 404 status. Everything else falls through to the static assets (and _headers).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coding-sh-site",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs first on every path except the files a page loads:
    // Astro's hashed files, search, social cards, icons and the manifest.
    // Those come straight from the assets, with _headers. Each request the
    // Worker runs on counts toward the plan's daily limit, and an asset
    // request does not. Past the free plan's 100,000 a day, every path the
    // Worker runs on answers 429 (Error 1027) until midnight UTC.
    // test/worker-first.test.mjs checks this list against the built site.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/pagefind/*",
      "!/og/*",
      "!/og-image.png",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/apple-touch-icon.png",
      "!/icon-16.png",
      "!/icon-32.png",
      "!/icon-192.png",
      "!/icon-512.png",
      "!/site.webmanifest"
    ],
    "not_found_handling": "404-page",
    // Pages live at /docs/quickstart (no trailing slash): the form every
    // internal link, the canonical tags and the sitemap use (trailingSlash:
    // "never" in astro.config.mjs). /docs/quickstart/ redirects to it.
    "html_handling": "drop-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true
}
