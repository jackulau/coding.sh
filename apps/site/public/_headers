# Cloudflare Pages headers.
#
# Everything Astro emits under /_astro/ has a content hash in its filename, so a
# changed file is always a changed URL. That makes it safe to cache forever —
# without this, repeat visitors keep revalidating JS and CSS that can never have
# changed under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Agent-facing text: llms.txt, llms-full.txt, and the per-page Markdown twins.
# Served as UTF-8 text so a crawler renders them instead of downloading them,
# and CORS-open so a browser-based agent can fetch them cross-origin.
/*.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Images and fonts in public/ are not content-hashed, so they get a shorter TTL
# plus revalidation rather than an immutable year.
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Self-hosted fonts: rarely change, preloaded on every page.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# The installer: `curl -fsSL https://coding.sh/install | sh`. Plain text so a
# browser shows the script instead of downloading it.
/install
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/changelog.xml
  Content-Type: application/atom+xml; charset=utf-8
