# Cloudflare Pages headers.
#
# Everything Astro emits under /_astro/ (JS, CSS, images, the Geist fonts) has
# a content hash in its filename, so a changed file is always a changed URL.
# That makes it safe to cache forever — without this, repeat visitors keep
# revalidating JS and CSS that can never have changed under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Agent-facing text: llms.txt, llms-full.txt, and the per-page Markdown twins.
# Served as UTF-8 text so a crawler renders them instead of downloading them,
# and CORS-open so a browser-based agent can fetch them cross-origin.
/*.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The trace format's JSON Schema: CORS-open so validators can fetch it by its $id.
/schema.json
  Content-Type: application/schema+json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Icons, the manifest and social cards in public/ are not content-hashed, so
# they get a day plus revalidation rather than an immutable year. Each rule
# names its files: a pattern like /*.png would also match /_astro/*, and two
# matching rules join their Cache-Control values with a comma.
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/site.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Search (Pagefind). The index and fragment files and the meta file have a
# content hash in their names; the loader, its worker and the wasm do not.
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/pagefind.*.pf_meta
  Cache-Control: public, max-age=31536000, immutable

/pagefind/pagefind.js
  Cache-Control: public, max-age=3600

/pagefind/pagefind-worker.js
  Cache-Control: public, max-age=3600

/pagefind/wasm.*
  Cache-Control: public, max-age=3600

# The installer: `curl -fsSL https://coding.sh/install | sh`. Plain text so a
# browser shows the script instead of downloading it.
/install
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# The Atom feed as application/xml: Cloudflare compresses that type and not
# application/atom+xml. Feed readers go by the <feed> root.
/changelog.xml
  Content-Type: application/xml; charset=utf-8
