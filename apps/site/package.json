{
  "name": "@coding.sh/site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prebuild": "npm run build -w coding.sh",
    "dev": "astro dev",
    "build": "node scripts/gen-og.mjs --missing && astro build && pagefind --site dist --exclude-selectors \"[data-agent-skip]\" && node scripts/gen-agent-text.mjs && node scripts/seo-check.mjs",
    "preview": "astro preview",
    "check": "astro check && npm test",
    "test": "node --test \"test/*.test.mjs\"",
    "test:dist": "CODING_SH_REQUIRE_DIST=1 node --test \"test/*.test.mjs\"",
    "perf:budget": "node scripts/perf-budget.mjs",
    "og": "node scripts/gen-og.mjs",
    "seo": "node scripts/seo-check.mjs",
    "astro": "astro",
    "icons": "node scripts/gen-icons.mjs",
    "shots:seed": "node --experimental-strip-types scripts/shots/seed.mjs",
    "shots:capture": "node scripts/shots/capture.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^5.16.4",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "lighthouse": "13.6.0",
    "pagefind": "1.5.2",
    "typescript": "^5.9.3"
  }
}
