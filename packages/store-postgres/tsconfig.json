{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Resolve coding.sh/store to its TypeScript source in the workspace (published installs use dist/types).
    "customConditions": ["source"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // html.d.ts: test/session-lock.test.ts imports coding.sh/server, whose viewer inlines its page.
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs", "../coding.sh/src/viewer/ui/html.d.ts"]
}
