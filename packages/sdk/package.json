{
  "name": "@codingdotsh/sdk",
  "version": "0.1.2",
  "description": "Trace any AI agent or LLM app in production: wrap OpenAI, Anthropic, the AI SDK or fetch and send every model call, tool call and turn to a coding.sh server.",
  "license": "MIT",
  "author": "coding.sh contributors",
  "type": "module",
  "homepage": "https://coding.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackulau/coding.sh.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/jackulau/coding.sh/issues"
  },
  "keywords": [
    "ai-agents",
    "observability",
    "evals",
    "opentelemetry",
    "llm",
    "claude-code",
    "codex",
    "llm-observability",
    "tracing",
    "openai",
    "anthropic",
    "ai-sdk",
    "sdk"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs --soft",
    "test": "node --no-warnings --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "*",
    "openai": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.110",
    "@ai-sdk/otel": "^1.0.164",
    "@anthropic-ai/sdk": "^1.6.0",
    "@opentelemetry/api": "^1.10.0",
    "@types/node": "^22.15.0",
    "ai": "^7.0.164",
    "ai-v6": "npm:ai@^6.0.324",
    "openai": "^7.53.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
