#!/bin/sh
# coding.sh pre-push: the commit identity check, the anti-slop lint on the files
# the push changes, and a typecheck of each package it touches. No tests: CI runs
# them, and `npm run gate` runs them here. Opt in with `npm run hooks:install`.
# Skip once with `git push --no-verify`, or set CODING_SH_SKIP_HOOKS=1.
exec node "$(git rev-parse --show-toplevel)/scripts/hooks/run.mjs" pre-push "$@"
